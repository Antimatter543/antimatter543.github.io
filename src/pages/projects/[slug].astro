---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { formatProjectDate, getProjectDuration } from '../../utils/projects';

// Generate static paths for all projects
export async function getStaticPaths() {
  const projectEntries = await getCollection('projects');

  return projectEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get project data from the props
const { entry } = Astro.props;

// If project doesn't have a writeup, redirect to external URL
if (!entry.data.hasWriteup) {
  const externalUrl = entry.data.externalUrl || entry.data.liveUrl || entry.data.githubUrl;
  if (externalUrl) {
    return Astro.redirect(externalUrl);
  }
}

const { Content } = await entry.render();

// Format dates
const startDate = formatProjectDate(entry.data.startDate);
const endDate = entry.data.endDate ? formatProjectDate(entry.data.endDate) : 'Present';
const duration = getProjectDuration(entry.data.startDate, entry.data.endDate);
const statusText = entry.data.status === 'in-progress' ? 'in progress' : entry.data.status;
const techLine = entry.data.technologies.join(' · ');
---

<Layout title={`${entry.data.title} | Projects | Antiraedus`} description={entry.data.description} image={entry.data.image}>
  <main class="project-post">
    <article>
      <div class="post-layout">
        <div class="post-main">
          <header class="blog-header">
            <a href="/projects" class="back-link">
              <span class="arrow" aria-hidden="true">&larr;</span> Back to projects
            </a>

            <p class="post-meta">
              {statusText}
              <span aria-hidden="true"> · </span>
              <time datetime={entry.data.startDate.toISOString()}>{startDate}</time> &ndash; <time datetime={entry.data.endDate ? entry.data.endDate.toISOString() : undefined}>{endDate}</time>
              <span aria-hidden="true"> · </span>{duration}
              <span aria-hidden="true"> · </span>{entry.data.category}
            </p>

            <h1>{entry.data.title}</h1>

            {entry.data.description && (
              <p class="post-lede">{entry.data.description}</p>
            )}

            {techLine && (
              <p class="tech-line">{techLine}</p>
            )}

            {entry.data.image && (
              <div class="featured-image">
                <img src={entry.data.image} alt={entry.data.imageAlt} />
              </div>
            )}

            <div class="project-actions">
              {entry.data.liveUrl && (
                <a href={entry.data.liveUrl} target="_blank" rel="noopener noreferrer" class="arrow-link">
                  View live <span class="arrow" aria-hidden="true">&rarr;</span>
                </a>
              )}
              {entry.data.githubUrl && (
                <a href={entry.data.githubUrl} target="_blank" rel="noopener noreferrer" class="arrow-link">
                  Source code <span class="arrow" aria-hidden="true">&rarr;</span>
                </a>
              )}
            </div>
          </header>

          <div class="project-content">
            <Content />
          </div>

          <div class="blog-navigation">
            <a href="/projects" class="back-link">
              <span class="arrow" aria-hidden="true">&larr;</span> Back to all projects
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>
</Layout>

<style>
  /* ---- Layout ---- */
  .project-post {
    padding: clamp(5rem, 10vw, 7rem) 0 clamp(4rem, 8vw, 6rem);
  }

  .post-layout {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .post-main {
    max-width: var(--measure);
    margin: 0 auto;
    width: 100%;
    min-width: 0;
  }

  /* ---- Arrow back-link ---- */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .back-link:hover {
    border-bottom-color: var(--accent);
  }

  .back-link .arrow {
    transition: transform 0.3s ease;
  }

  .back-link:hover .arrow {
    transform: translateX(-4px);
  }

  /* ---- Article header ---- */
  .blog-header {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .post-meta {
    margin: 2rem 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    text-transform: capitalize;
  }

  .blog-header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .post-lede {
    margin: 1.1rem 0 0;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-alt);
  }

  .tech-line {
    margin: 0.75rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
  }

  .featured-image {
    margin: 2.5rem 0 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .featured-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ---- Actions ---- */
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 1.75rem;
  }

  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .arrow-link:hover {
    border-bottom-color: var(--accent);
  }

  .arrow-link .arrow {
    transition: transform 0.3s ease;
  }

  .arrow-link:hover .arrow {
    transform: translateX(4px);
  }

  /* ---- Project Content (matches blog typography) ---- */
  .project-content {
    line-height: 1.75;
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .project-content :global(h2),
  .project-content :global(h3),
  .project-content :global(h4) {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .project-content :global(h2) {
    font-size: 2.1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .project-content :global(h3) {
    font-size: 1.5rem;
  }

  .project-content :global(h4) {
    font-size: 1.25rem;
    color: var(--color-text-alt);
  }

  .project-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .project-content :global(ul),
  .project-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .project-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .project-content :global(li::marker) {
    color: var(--color-text-dim);
  }

  /* ---- Blockquotes: 2px accent rule, display serif italic ---- */
  .project-content :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 2px solid var(--accent);
    background: transparent;
    box-shadow: none;
    border-radius: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-heading);
  }

  .project-content :global(blockquote p) {
    margin-bottom: 0.75rem;
  }

  .project-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* ---- Code ---- */
  .project-content :global(code) {
    font-family: var(--font-mono);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-rule);
    padding: 0.12em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.85em;
    color: var(--color-heading);
  }

  .project-content :global(pre) {
    background-color: var(--color-bg-alt) !important;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    margin: 2rem 0;
    padding: 1.25rem 1.4rem;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .project-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  /* ---- Media ---- */
  .project-content :global(img) {
    max-width: 100%;
    border-radius: var(--radius-sm);
    margin: 2rem auto;
    display: block;
    box-shadow: none;
  }

  .project-content :global(table) {
    width: 100%;
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.95rem;
  }

  .project-content :global(th),
  .project-content :global(td) {
    border-bottom: 1px solid var(--color-rule);
    padding: 0.6rem 0.9rem;
    text-align: left;
  }

  .project-content :global(th) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
    font-weight: 400;
  }

  .project-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .project-content :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  .project-content :global(hr) {
    border: none;
    height: 1px;
    background: var(--color-rule);
    margin: 3rem 0;
  }

  /* ---- Navigation ---- */
  .blog-navigation {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-rule);
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .post-layout {
      padding: 0 1.25rem;
    }

    .blog-header h1 {
      font-size: clamp(2rem, 8vw, 2.6rem);
    }

    .project-content {
      font-size: 1.02rem;
    }

    .project-content :global(h2) {
      font-size: 1.7rem;
    }

    .project-content :global(h3) {
      font-size: 1.35rem;
    }

    .project-content :global(blockquote) {
      font-size: 1.15rem;
      padding-left: 1.1rem;
    }

    .project-content :global(pre) {
      padding: 1rem;
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link .arrow,
    .arrow-link .arrow {
      transition: none;
    }

    .back-link:hover .arrow,
    .arrow-link:hover .arrow {
      transform: none;
    }
  }
</style>
