---
import Layout from '../layouts/Layout.astro';
import { getAllProjects, getProjectCategories, getAllTechnologies } from '../utils/projects';
import type { Project } from '../utils/projects';

// Get all projects and metadata
const allProjects = await getAllProjects();
const categories = await getProjectCategories();
const technologies = await getAllTechnologies();

// Client-side filtering setup
---

<Layout title="Projects | Antiraedus" description="Browse all of my projects and portfolio work">
  <div class="page">
    <header class="page-head">
      <span class="page-eyebrow">Projects</span>
      <h1 class="page-title">Things I've built</h1>
      <p class="page-lede">Experiments, tools, and things I've shipped along the way.</p>
    </header>

    <div class="filters">
      <div class="filter-group">
        <label for="category-filter" class="filter-label">Category</label>
        <select id="category-filter" class="filter-select">
          <option value="all">All Categories</option>
          {categories.map((category) => (
            <option value={category.toLowerCase()}>{category}</option>
          ))}
        </select>
      </div>

      <div class="filter-group">
        <label for="tech-filter" class="filter-label">Technology</label>
        <select id="tech-filter" class="filter-select">
          <option value="all">All Technologies</option>
          {technologies.map((tech) => (
            <option value={tech.toLowerCase()}>{tech}</option>
          ))}
        </select>
      </div>

      <div class="filter-group">
        <label for="status-filter" class="filter-label">Status</label>
        <select id="status-filter" class="filter-select">
          <option value="all">All Statuses</option>
          <option value="completed">Completed</option>
          <option value="in-progress">In Progress</option>
          <option value="planned">Planned</option>
        </select>
      </div>
    </div>

    <div class="rows" id="projects-grid">
      {allProjects.map((project) => {
        const href = project.data.hasWriteup
          ? `/projects/${project.slug}`
          : (project.data.externalUrl || project.data.liveUrl || project.data.githubUrl || '#');
        const statusText = project.data.status === 'in-progress' ? 'in progress' : project.data.status;
        const techLine = [...project.data.technologies, project.data.category].join(' · ');

        return (
          <a
            href={href}
            class="row project-card"
            target={project.data.hasWriteup ? '_self' : '_blank'}
            rel={project.data.hasWriteup ? '' : 'noopener noreferrer'}
            data-category={project.data.category.toLowerCase()}
            data-techs={project.data.technologies.map(t => t.toLowerCase()).join(' ')}
            data-status={project.data.status}
          >
            <span class="row-meta">{project.data.startDate.getFullYear()}</span>
            <span class="row-title-group">
              <span class="row-title">{project.data.title}</span>
              <span class="row-tech">{techLine}</span>
            </span>
            <span class="row-desc">{project.data.description}</span>
            <span class="row-tail">
              <span class="row-status">{statusText}</span>
              <span class="row-arrow" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        );
      })}
    </div>
  </div>
</Layout>

<style>
  /* ---- Page shell ---- */
  .page {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(6rem, 12vw, 9rem) 2rem clamp(5rem, 10vw, 8rem);
  }

  /* ---- Editorial page header ---- */
  .page-head {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .page-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 1rem;
  }

  .page-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .page-lede {
    margin: 1rem 0 0;
    max-width: 52ch;
    font-size: 1.05rem;
    color: var(--color-text-alt);
  }

  /* ---- Filters ---- */
  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .filter-group {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .filter-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .filter-select {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--color-text);
    background: var(--color-bg-alt);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.75rem;
    min-width: 180px;
    cursor: pointer;
    transition: border-color 0.3s ease;
  }

  .filter-select:hover,
  .filter-select:focus {
    outline: none;
    border-color: var(--accent);
  }

  .filter-select option {
    background: var(--color-bg-alt);
    color: var(--color-text);
  }

  /* ---- Row list ---- */
  .rows {
    border-bottom: 1px solid var(--color-rule);
  }

  .row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) minmax(0, 1.3fr) auto;
    align-items: baseline;
    gap: 0 1.5rem;
    padding: 1.4rem 0.75rem;
    margin: 0 -0.75rem;
    border-top: 1px solid var(--color-rule);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.3s ease;
  }

  .row:hover {
    background: var(--accent-soft);
  }

  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    white-space: nowrap;
  }

  .row-title-group {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
  }

  .row-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    transition: color 0.3s ease;
  }

  .row:hover .row-title {
    color: var(--accent);
  }

  .row-tech {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .row-desc {
    color: var(--color-text-alt);
    font-size: 0.95rem;
    line-height: 1.6;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .row-tail {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    justify-content: flex-end;
  }

  .row-status {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    white-space: nowrap;
  }

  .row-arrow {
    color: var(--color-text-dim);
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .row:hover .row-arrow {
    color: var(--accent);
    transform: translateX(6px);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr auto;
      gap: 0.4rem 1rem;
      padding: 1.25rem 0.5rem;
      margin: 0 -0.5rem;
    }

    .row-meta {
      grid-column: 1 / -1;
      order: -1;
    }

    .row-title {
      font-size: 1.3rem;
    }

    .row-desc {
      grid-column: 1 / -1;
      -webkit-line-clamp: 3;
    }

    .row-tail {
      align-self: start;
      gap: 0.6rem;
    }

    .row-status {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .page {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .filters {
      gap: 1.25rem;
    }

    .filter-select {
      min-width: 0;
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-arrow {
      transition: none;
    }

    .row:hover .row-arrow {
      transform: none;
    }
  }
</style>

<script>
  // Client-side filtering
  const projectsGrid = document.getElementById('projects-grid');
  const categoryFilter = document.getElementById('category-filter');
  const techFilter = document.getElementById('tech-filter');
  const statusFilter = document.getElementById('status-filter');

  function filterProjects() {
    if (!projectsGrid || !categoryFilter || !techFilter || !statusFilter) return;

    const selectedCategory = (categoryFilter as HTMLSelectElement).value;
    const selectedTech = (techFilter as HTMLSelectElement).value;
    const selectedStatus = (statusFilter as HTMLSelectElement).value;

    const projects = projectsGrid.querySelectorAll('.project-card');

    projects.forEach((project) => {
      const element = project as HTMLElement;
      const projectCategory = element.dataset.category || '';
      const projectTechs = element.dataset.techs || '';
      const projectStatus = element.dataset.status || '';

      const matchesCategory = selectedCategory === 'all' || projectCategory === selectedCategory;
      const matchesTech = selectedTech === 'all' || projectTechs.includes(selectedTech);
      const matchesStatus = selectedStatus === 'all' || projectStatus === selectedStatus;

      if (matchesCategory && matchesTech && matchesStatus) {
        element.style.display = 'grid';
      } else {
        element.style.display = 'none';
      }
    });
  }

  // Add event listeners
  categoryFilter?.addEventListener('change', filterProjects);
  techFilter?.addEventListener('change', filterProjects);
  statusFilter?.addEventListener('change', filterProjects);
</script>
