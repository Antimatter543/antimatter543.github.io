---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Get all blog posts, sorted by publication date
const posts = await getCollection('blog', ({ data }) => {
  // Filter out draft posts
  return !data.draft;
});

// Sort posts by publication date (newest first)
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Calculate reading time from word count
function getReadingTime(body: string): number {
  const wordsPerMinute = 200;
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.ceil(words / wordsPerMinute));
}

// Split into featured (latest) and the rest
const [featuredPost, ...remainingPosts] = sortedPosts;
---

<Layout title="Blog | Antiraedus" description="Read my latest articles and thoughts">
  <div class="page">
    <header class="page-head">
      <span class="page-eyebrow">Blog</span>
      <h1 class="page-title">Writing</h1>
      <p class="page-lede">Thoughts, ideas, and everything in between.</p>
    </header>

    {/* Feature panel — the latest post */}
    {featuredPost && (
      <a href={`/blog/${featuredPost.slug}`} class="feature">
        {featuredPost.data.heroImage && (
          <div class="feature-media">
            <img src={featuredPost.data.heroImage} alt={featuredPost.data.title} loading="eager" />
          </div>
        )}
        <div class="feature-body">
          <p class="feature-eyebrow">Latest</p>
          <h2 class="feature-title">{featuredPost.data.title}</h2>
          <p class="feature-meta">
            <time datetime={featuredPost.data.pubDate.toISOString()}>
              {featuredPost.data.pubDate.toLocaleDateString('en-US', {
                year: 'numeric',
                month: 'long',
                day: 'numeric'
              })}
            </time>
            <span aria-hidden="true"> · </span>{getReadingTime(featuredPost.body)} min read{
              featuredPost.data.tags && featuredPost.data.tags.length > 0 && (
                <Fragment><span aria-hidden="true"> · </span>{featuredPost.data.tags.join(' · ')}</Fragment>
              )
            }
          </p>
          <p class="feature-desc">{featuredPost.data.description}</p>
          <span class="arrow-link">Read the post <span class="arrow" aria-hidden="true">&rarr;</span></span>
        </div>
      </a>
    )}

    {/* Row list — everything else */}
    {remainingPosts.length > 0 && (
      <div class="rows">
        {remainingPosts.map((post) => (
          <a href={`/blog/${post.slug}`} class="row">
            <span class="row-meta">
              <time datetime={post.data.pubDate.toISOString()}>
                {post.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}
              </time>
            </span>
            <span class="row-lead">
              <span class="row-title">{post.data.title}</span>
              <span class="row-tags">
                {post.data.tags && post.data.tags.length > 0
                  ? post.data.tags.join(' · ')
                  : `${getReadingTime(post.body)} min`}
              </span>
            </span>
            <span class="row-desc">{post.data.description}</span>
            <span class="row-arrow" aria-hidden="true">&rarr;</span>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  /* ---- Page shell ---- */
  .page {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(6rem, 12vw, 9rem) 2rem clamp(5rem, 10vw, 8rem);
  }

  /* ---- Editorial page header ---- */
  .page-head {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .page-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 1rem;
  }

  .page-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .page-lede {
    margin: 1rem 0 0;
    max-width: 52ch;
    font-size: 1.05rem;
    color: var(--color-text-alt);
  }

  /* ---- Feature panel ---- */
  .feature {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    margin-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .feature:not(:has(.feature-media)) {
    grid-template-columns: 1fr;
  }

  .feature-media {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.75rem;
    border-right: 1px solid var(--color-rule);
    min-width: 0;
  }

  .feature-media img {
    width: 100%;
    max-height: 300px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    display: block;
  }

  .feature-body {
    padding: clamp(1.75rem, 4vw, 2.75rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.85rem;
    min-width: 0;
  }

  .feature-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .feature-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(1.9rem, 3.2vw, 2.6rem);
    line-height: 1.08;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    transition: color 0.3s ease;
  }

  .feature:hover .feature-title {
    color: var(--accent);
  }

  .feature-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
  }

  .feature-desc {
    margin: 0;
    color: var(--color-text-alt);
    line-height: 1.7;
  }

  /* ---- Arrow link ---- */
  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    align-self: flex-start;
    margin-top: 0.35rem;
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .feature:hover .arrow-link {
    border-bottom-color: var(--accent);
  }

  .arrow-link .arrow {
    transition: transform 0.3s ease;
  }

  .feature:hover .arrow-link .arrow {
    transform: translateX(4px);
  }

  /* ---- Row list ---- */
  .row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) minmax(0, 1.2fr) 1.5rem;
    align-items: baseline;
    gap: 0 1.5rem;
    padding: 1.4rem 0.75rem;
    margin: 0 -0.75rem;
    border-top: 1px solid var(--color-rule);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.3s ease;
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .row:hover {
    background: var(--accent-soft);
  }

  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    white-space: nowrap;
  }

  .row-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    transition: color 0.3s ease;
  }

  .row:hover .row-title {
    color: var(--accent);
  }

  .row-desc {
    color: var(--color-text-alt);
    font-size: 0.95rem;
    line-height: 1.6;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
  }

  .row-lead {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
    min-width: 0;
  }

  .row-tags {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    font-style: normal;
  }

  .row-arrow {
    color: var(--color-text-dim);
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .row:hover .row-arrow {
    color: var(--accent);
    transform: translateX(6px);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .feature {
      grid-template-columns: 1fr;
    }

    .feature-media {
      border-right: none;
      border-bottom: 1px solid var(--color-rule);
      padding: 1.25rem;
    }

    .feature-media img {
      max-height: 220px;
    }

    .row {
      grid-template-columns: 1fr auto;
      gap: 0.4rem 1rem;
      padding: 1.25rem 0.5rem;
      margin: 0 -0.5rem;
    }

    .row-meta {
      grid-column: 1 / -1;
      order: -1;
    }

    .row-title {
      font-size: 1.3rem;
    }

    .row-desc {
      grid-column: 1 / -1;
      -webkit-line-clamp: 3;
    }

    .row-tags {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .page {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-arrow,
    .arrow-link .arrow {
      transition: none;
    }

    .row:hover .row-arrow,
    .feature:hover .arrow-link .arrow {
      transform: none;
    }
  }
</style>
