---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

// Get all creative content, sorted by publication date
const creatives = await getCollection('creatives', ({ data }) => {
  // Filter out draft posts in production
  return process.env.NODE_ENV === 'production' ? !data.draft : true;
});

// Sort creatives by publication date (newest first)
const sortedCreatives = creatives.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// The first featured entry gets the pull-quote treatment above the list.
// It still appears in the row list below.
const featured = sortedCreatives.find((item) => item.data.featured === true);
---

<Layout title="Creatives | Antiraedus" description="Poems, stories, quotes, and thoughts">
  <div class="page">
    <header class="page-head">
      <span class="page-eyebrow">Creatives</span>
      <h1 class="page-title">Loose thoughts</h1>
      <p class="page-lede">A collection of less structured, more liberal thoughts. Perhaps the seeds of ideas?</p>
    </header>

    {/* Featured pull-quote — flat, no card */}
    {featured && (
      <div class="featured-quote">
        <p class="quote-text">
          {featured.data.title}
          {featured.data.description && (
            <Fragment><br />{featured.data.description}</Fragment>
          )}
        </p>
        <p class="quote-attribution">
          {featured.data.category}
          <span aria-hidden="true"> · </span>
          <time datetime={featured.data.pubDate.toISOString()}>
            {featured.data.pubDate.toLocaleDateString('en-US', {
              year: 'numeric',
              month: 'short',
              day: 'numeric'
            })}
          </time>
        </p>
        <a href={`/creatives/${featured.slug}`} class="arrow-link">
          Read it <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      </div>
    )}

    {/* Category filter — plain mono row, no pills */}
    <div class="tabs">
      <button class="tab-button active" data-category="all">All</button>
      <button class="tab-button" data-category="poem">Poems</button>
      <button class="tab-button" data-category="story">Stories</button>
      <button class="tab-button" data-category="quote">Quotes</button>
      <button class="tab-button" data-category="thought">Thoughts</button>
    </div>

    {/* Row list */}
    {sortedCreatives.length > 0 && (
      <div class="rows">
        {sortedCreatives.map((creative) => (
          <a href={`/creatives/${creative.slug}`} class="row" data-category={creative.data.category}>
            <span class="row-meta">
              <time datetime={creative.data.pubDate.toISOString()}>
                {creative.data.pubDate.toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'short',
                  day: 'numeric'
                })}
              </time>
            </span>
            <span class="row-title">{creative.data.title}</span>
            <span class="row-desc">{creative.data.description}</span>
            <span class="row-tail">
              <span class="row-cat">{creative.data.category}</span>
              <span class="row-arrow" aria-hidden="true">&rarr;</span>
            </span>
          </a>
        ))}
      </div>
    )}
  </div>
</Layout>

<style>
  /* ---- Page shell ---- */
  .page {
    max-width: var(--container);
    margin: 0 auto;
    padding: clamp(6rem, 12vw, 9rem) 2rem clamp(5rem, 10vw, 8rem);
  }

  /* ---- Editorial page header ---- */
  .page-head {
    margin-bottom: clamp(3rem, 6vw, 5rem);
  }

  .page-eyebrow {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    margin-bottom: 1rem;
  }

  .page-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.8rem, 6vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .page-lede {
    margin: 1rem 0 0;
    max-width: 52ch;
    font-size: 1.05rem;
    color: var(--color-text-alt);
  }

  /* ---- Featured pull-quote (flat, no card) ---- */
  .featured-quote {
    margin: 0 0 clamp(3rem, 6vw, 4.5rem);
    padding: 0.25rem 0 0.25rem 1.75rem;
    border-left: 2px solid var(--accent);
  }

  .quote-text {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(1.6rem, 3.2vw, 2.4rem);
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--color-heading);
  }

  .quote-attribution {
    margin: 1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    text-transform: uppercase;
  }

  .arrow-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-top: 0.85rem;
    color: var(--accent);
    font-weight: 500;
    font-size: 0.95rem;
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .arrow-link:hover {
    border-bottom-color: var(--accent);
  }

  .arrow-link .arrow {
    transition: transform 0.3s ease;
  }

  .arrow-link:hover .arrow {
    transform: translateX(4px);
  }

  /* ---- Category tabs: plain mono row ---- */
  .tabs {
    display: flex;
    align-items: baseline;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .tab-button {
    padding: 0 0 0.3rem;
    border: none;
    border-bottom: 1px solid transparent;
    background: transparent;
    cursor: pointer;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-text-dim);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .tab-button:hover {
    color: var(--color-text-alt);
  }

  .tab-button.active {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }

  /* ---- Row list ---- */
  .rows {
    border-bottom: 1px solid var(--color-rule);
  }

  .row {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr) minmax(0, 1.3fr) auto;
    align-items: baseline;
    gap: 0 1.5rem;
    padding: 1.4rem 0.75rem;
    margin: 0 -0.75rem;
    border-top: 1px solid var(--color-rule);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.3s ease;
  }

  .row:hover {
    background: var(--accent-soft);
  }

  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    white-space: nowrap;
  }

  .row-title {
    font-family: var(--font-display);
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    transition: color 0.3s ease;
  }

  .row:hover .row-title {
    color: var(--accent);
  }

  .row-desc {
    color: var(--color-text-alt);
    font-size: 0.95rem;
    line-height: 1.6;
    overflow: hidden;
    display: -webkit-box;
    -webkit-line-clamp: 1;
    -webkit-box-orient: vertical;
  }

  .row-tail {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    justify-content: flex-end;
  }

  .row-cat {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    white-space: nowrap;
    text-transform: lowercase;
  }

  .row-arrow {
    color: var(--color-text-dim);
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .row:hover .row-arrow {
    color: var(--accent);
    transform: translateX(6px);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .row {
      grid-template-columns: 1fr auto;
      gap: 0.4rem 1rem;
      padding: 1.25rem 0.5rem;
      margin: 0 -0.5rem;
    }

    .row-meta {
      grid-column: 1 / -1;
      order: -1;
    }

    .row-title {
      font-size: 1.3rem;
    }

    .row-desc {
      grid-column: 1 / -1;
      -webkit-line-clamp: 2;
    }

    .row-tail {
      align-self: start;
      gap: 0.6rem;
    }

    .row-cat {
      display: none;
    }
  }

  @media (max-width: 600px) {
    .page {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-arrow,
    .arrow-link .arrow {
      transition: none;
    }

    .row:hover .row-arrow,
    .arrow-link:hover .arrow {
      transform: none;
    }
  }
</style>

<script>
  // Category filtering — the row itself is the link, toggle it directly.
  const tabButtons = document.querySelectorAll('.tab-button');
  const rows = document.querySelectorAll('.row[data-category]');

  tabButtons.forEach((button) => {
    button.addEventListener('click', () => {
      const category = button.getAttribute('data-category');

      tabButtons.forEach((btn) => btn.classList.remove('active'));
      button.classList.add('active');

      rows.forEach((row) => {
        const el = row as HTMLElement;
        if (category === 'all' || el.getAttribute('data-category') === category) {
          el.style.display = 'grid';
        } else {
          el.style.display = 'none';
        }
      });
    });
  });
</script>
