---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

// Generate static paths for all creative content
export async function getStaticPaths() {
  const creativeEntries = await getCollection('creatives', ({ data }) => {
    // Filter out draft posts in production
    return process.env.NODE_ENV === 'production' ? !data.draft : true;
  });

  return creativeEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get creative content data from the props
const { entry } = Astro.props;
const { Content } = await entry.render();

// Format the publication date
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(entry.data.pubDate);
---

<Layout title={`${entry.data.title} | Creatives | Antiraedus`} description={entry.data.description}>
  <main class="creative-post">
    <article>
      <div class="container">
        <header class="creative-header">
          <a href="/creatives" class="back-link">
            <span class="arrow" aria-hidden="true">&larr;</span> Back to creatives
          </a>

          <p class="post-meta">
            {entry.data.category}
            <span aria-hidden="true"> · </span>
            <time datetime={entry.data.pubDate.toISOString()}>{formattedDate}</time>
            {entry.data.tags && entry.data.tags.length > 0 && (
              entry.data.tags.map((tag: string) => (
                <Fragment><span aria-hidden="true"> · </span>{tag}</Fragment>
              ))
            )}
          </p>

          <h1>{entry.data.title}</h1>

          {entry.data.description && (
            <p class="post-lede">{entry.data.description}</p>
          )}
        </header>

        <div class="creative-content">
          <Content />
        </div>

        <div class="creative-footer">
          <a href="/creatives" class="back-link">
            <span class="arrow" aria-hidden="true">&larr;</span> Back to creatives
          </a>
        </div>
      </div>
    </article>
  </main>
</Layout>

<style>
  /* ---- Layout ---- */
  .creative-post {
    padding: clamp(5rem, 10vw, 7rem) 0 clamp(4rem, 8vw, 6rem);
  }

  .container {
    max-width: var(--measure);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- Arrow back-link ---- */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .back-link:hover {
    border-bottom-color: var(--accent);
  }

  .back-link .arrow {
    transition: transform 0.3s ease;
  }

  .back-link:hover .arrow {
    transform: translateX(-4px);
  }

  /* ---- Article header ---- */
  .creative-header {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .post-meta {
    margin: 2rem 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    text-transform: lowercase;
  }

  .creative-header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .post-lede {
    margin: 1.1rem 0 0;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-alt);
  }

  /* ---- Creative content ---- */
  .creative-content {
    max-width: var(--measure);
    line-height: 1.75;
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .creative-content :global(h1),
  .creative-content :global(h2),
  .creative-content :global(h3),
  .creative-content :global(h4) {
    font-family: var(--font-display);
    font-weight: 700;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .creative-content :global(h2) {
    font-size: 2.1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .creative-content :global(h3) {
    font-size: 1.5rem;
  }

  .creative-content :global(p) {
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .creative-content :global(em) {
    font-style: italic;
  }

  .creative-content :global(strong) {
    color: var(--color-heading);
    font-weight: 600;
  }

  /* Poetry often relies on trailing line breaks inside one paragraph —
     give them a little breathing room instead of the default cramped gap. */
  .creative-content :global(br) {
    content: '';
    display: block;
    margin-bottom: 0.35em;
  }

  .creative-content :global(ul),
  .creative-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .creative-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .creative-content :global(li::marker) {
    color: var(--color-text-dim);
  }

  /* ---- Blockquotes: 2px accent rule, display serif italic ---- */
  .creative-content :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 2px solid var(--accent);
    background: transparent;
    box-shadow: none;
    border-radius: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-heading);
  }

  .creative-content :global(blockquote p) {
    margin-bottom: 0.75rem;
  }

  .creative-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* ---- Code ---- */
  .creative-content :global(code) {
    font-family: var(--font-mono);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-rule);
    padding: 0.12em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.85em;
    color: var(--color-heading);
  }

  .creative-content :global(pre) {
    background-color: var(--color-bg-alt) !important;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    margin: 2rem 0;
    padding: 1.25rem 1.4rem;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .creative-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  /* ---- Media ---- */
  .creative-content :global(img) {
    max-width: 100%;
    border-radius: var(--radius-sm);
    margin: 2rem auto;
    display: block;
    box-shadow: none;
  }

  .creative-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .creative-content :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  .creative-content :global(hr) {
    border: none;
    height: 1px;
    background: var(--color-rule);
    margin: 3rem 0;
  }

  /* ---- Footer navigation ---- */
  .creative-footer {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-rule);
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .container {
      padding: 0 1.25rem;
    }

    .creative-content {
      font-size: 1.02rem;
    }

    .creative-content :global(h2) {
      font-size: 1.7rem;
    }

    .creative-content :global(h3) {
      font-size: 1.35rem;
    }

    .creative-content :global(blockquote) {
      font-size: 1.15rem;
      padding-left: 1.1rem;
    }

    .creative-content :global(pre) {
      padding: 1rem;
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link .arrow {
      transition: none;
    }

    .back-link:hover .arrow {
      transform: none;
    }
  }
</style>
