---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Comments from '../../components/Comments.astro';
import StructuredData from '../../components/StructuredData.astro';

// Generate static paths for all blog posts
export async function getStaticPaths() {
  const blogEntries = await getCollection('blog', ({ data }) => {
    // Filter out draft posts
    return !data.draft;
  });

  return blogEntries.map(entry => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

// Get blog post data from the props
const { entry } = Astro.props;
const { Content, headings } = await entry.render();

// Format the publication date
const formattedDate = new Intl.DateTimeFormat('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric'
}).format(entry.data.pubDate);

// Calculate reading time
const wordsPerMinute = 200;
const words = entry.body.trim().split(/\s+/).length;
const readingTime = Math.max(1, Math.ceil(words / wordsPerMinute));

// One mono meta line: date · read time · tags
const metaParts = [formattedDate, `${readingTime} min read`, ...(entry.data.tags ?? [])];

// Filter headings for sidebar TOC (h2 and h3 only)
const tocHeadings = headings.filter(h => h.depth === 2 || h.depth === 3);

// SEO: default OG image when the post has no hero image
const defaultImage = '/profile-top.jpg';
const ogImage = entry.data.heroImage ?? defaultImage;

// Canonical URL for this post (used in JSON-LD)
const canonicalURL = new URL(Astro.url.pathname, Astro.site).toString();
const absoluteImage = new URL(ogImage, Astro.site).toString();

// JSON-LD BlogPosting structured data
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: entry.data.title,
  description: entry.data.description,
  datePublished: entry.data.pubDate.toISOString(),
  dateModified: (entry.data.updatedDate ?? entry.data.pubDate).toISOString(),
  author: {
    '@type': 'Person',
    name: 'Antiraedus',
  },
  ...(entry.data.heroImage ? { image: absoluteImage } : {}),
  url: canonicalURL,
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalURL,
  },
};
---

<Layout
  title={`${entry.data.title} | Blog | Antiraedus`}
  description={entry.data.description}
  image={ogImage}
  type="article"
  publishedTime={entry.data.pubDate.toISOString()}
  tags={entry.data.tags}
>
  <StructuredData data={structuredData} />
  <!-- Reading Progress Bar -->
  <div class="progress-bar-container">
    <div class="progress-bar" id="reading-progress"></div>
  </div>

  <main class="blog-post">
    <article>
      <div class="post-layout">
        <!-- Sidebar TOC (desktop only) -->
        {tocHeadings.length > 2 && (
          <aside class="toc-sidebar" id="toc-sidebar">
            <nav class="toc-nav">
              <div class="toc-label">On this page</div>
              <ul class="toc-list">
                {tocHeadings.map(heading => (
                  <li class={`toc-item toc-depth-${heading.depth}`}>
                    <a href={`#${heading.slug}`} class="toc-link">{heading.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}

        <div class="post-main">
          <header class="blog-header">
            <a href="/blog" class="back-link">
              <span class="arrow" aria-hidden="true">&larr;</span> Back to blog
            </a>

            <p class="post-meta">
              <time datetime={entry.data.pubDate.toISOString()}>{formattedDate}</time>
              {metaParts.slice(1).map((part) => (
                <Fragment><span aria-hidden="true"> · </span>{part}</Fragment>
              ))}
            </p>

            <h1>{entry.data.title}</h1>

            {entry.data.description && (
              <p class="post-lede">{entry.data.description}</p>
            )}

            {entry.data.heroImage && (
              <div class="featured-image">
                <img src={entry.data.heroImage} alt={entry.data.title} />
              </div>
            )}
          </header>

          <div class="blog-content">
            <Content />
          </div>

          <Comments />

          <div class="blog-navigation">
            <a href="/blog" class="back-link">
              <span class="arrow" aria-hidden="true">&larr;</span> Back to all posts
            </a>
          </div>
        </div>
      </div>
    </article>
  </main>
</Layout>

<script>
  // Reading progress bar
  function updateProgress() {
    const progressBar = document.getElementById('reading-progress');
    if (!progressBar) return;

    const docHeight = document.documentElement.scrollHeight - document.documentElement.clientHeight;
    const scrolled = window.scrollY;
    const progress = Math.min((scrolled / docHeight) * 100, 100);
    progressBar.style.width = `${progress}%`;
  }

  // Sticky TOC with active section tracking
  function initTOC() {
    const sidebar = document.getElementById('toc-sidebar');
    const tocLinks = document.querySelectorAll('.toc-link');
    if (!sidebar || tocLinks.length === 0) return;

    const headerHeight = 80;

    // Track active section
    const headingElements = Array.from(tocLinks).map(link => {
      const id = link.getAttribute('href')?.slice(1);
      return id ? document.getElementById(id) : null;
    }).filter(Boolean) as HTMLElement[];

    function updateActiveSection() {
      const scrollPos = window.scrollY + headerHeight + 40;

      let activeIndex = -1;
      for (let i = headingElements.length - 1; i >= 0; i--) {
        if (headingElements[i].offsetTop <= scrollPos) {
          activeIndex = i;
          break;
        }
      }

      tocLinks.forEach((link, index) => {
        if (index === activeIndex) {
          link.classList.add('active');
        } else {
          link.classList.remove('active');
        }
      });
    }

    // Show/hide TOC based on scroll position
    const blogHeader = document.querySelector('.blog-header');
    function updateTOCVisibility() {
      if (!blogHeader) return;
      const headerBottom = blogHeader.getBoundingClientRect().bottom;
      if (headerBottom < 0) {
        sidebar.classList.add('visible');
      } else {
        sidebar.classList.remove('visible');
      }
    }

    window.addEventListener('scroll', () => {
      updateActiveSection();
      updateTOCVisibility();
    }, { passive: true });

    updateActiveSection();
    updateTOCVisibility();
  }

  window.addEventListener('scroll', updateProgress, { passive: true });
  window.addEventListener('resize', updateProgress, { passive: true });
  updateProgress();

  document.addEventListener('DOMContentLoaded', initTOC);
  // Also run on astro page load for view transitions
  document.addEventListener('astro:page-load', () => {
    updateProgress();
    initTOC();
  });
</script>

<style>
  /* ---- Progress Bar ---- */
  .progress-bar-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 2px;
    z-index: 200;
    background: transparent;
  }

  .progress-bar {
    height: 100%;
    width: 0%;
    background: var(--accent);
    transition: width 0.1s linear;
  }

  /* ---- Post Layout ---- */
  .blog-post {
    padding: clamp(6rem, 11vw, 8rem) 0 clamp(4rem, 8vw, 6rem);
  }

  .post-layout {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
    display: grid;
    grid-template-columns: 1fr;
    position: relative;
  }

  .post-main {
    max-width: var(--measure);
    margin: 0 auto;
    width: 100%;
    min-width: 0;
  }

  /* ---- Sidebar TOC ---- */
  .toc-sidebar {
    display: none;
  }

  @media (min-width: 1280px) {
    /* Only widen to two columns when a TOC actually exists, so TOC-less
       posts keep their centered single-column layout. */
    .post-layout:has(.toc-sidebar) {
      grid-template-columns: minmax(0, 1fr) 200px;
      column-gap: 3rem;
    }

    /* Both items share row 1 so the aside stretches to the full article
       height — giving the sticky TOC nav room to stay pinned while the
       reader scrolls through the whole post. */
    .post-layout:has(.toc-sidebar) .post-main {
      grid-column: 1;
      grid-row: 1;
    }

    .toc-sidebar {
      display: block;
      grid-column: 2;
      grid-row: 1;
      align-self: stretch;
    }

    .toc-nav {
      position: sticky;
      top: 100px;
      max-height: calc(100vh - 140px);
      overflow-y: auto;
      scrollbar-width: thin;
      scrollbar-color: var(--color-rule) transparent;
    }

    .toc-label {
      font-family: var(--font-mono);
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--color-text-dim);
      margin-bottom: 0.9rem;
      padding-left: 0.75rem;
    }

    .toc-list {
      list-style: none;
      padding: 0;
      margin: 0;
      border-left: 1px solid var(--color-rule);
    }

    .toc-item {
      margin: 0;
    }

    .toc-depth-3 {
      padding-left: 0.75rem;
    }

    .toc-link {
      display: block;
      padding: 0.35rem 0.75rem;
      font-size: 0.8rem;
      line-height: 1.45;
      color: var(--color-text-dim);
      text-decoration: none;
      border-left: 2px solid transparent;
      margin-left: -1px;
      transition: color 0.3s ease, border-color 0.3s ease;
    }

    .toc-link:hover {
      color: var(--color-text);
    }

    .toc-link.active {
      color: var(--accent);
      border-left-color: var(--accent);
    }
  }

  /* ---- Arrow back-link ---- */
  .back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
  }

  .back-link:hover {
    border-bottom-color: var(--accent);
  }

  .back-link .arrow {
    transition: transform 0.3s ease;
  }

  .back-link:hover .arrow {
    transform: translateX(-4px);
  }

  /* ---- Article header ---- */
  .blog-header {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }

  .post-meta {
    margin: 2rem 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
  }

  .blog-header h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.4rem, 5vw, 3.8rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .post-lede {
    margin: 1.1rem 0 0;
    font-size: 1.15rem;
    line-height: 1.6;
    color: var(--color-text-alt);
  }

  .featured-image {
    margin: 2.5rem 0 0;
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .featured-image img {
    width: 100%;
    height: auto;
    display: block;
  }

  /* ---- Blog Content ---- */
  .blog-content {
    line-height: 1.75;
    font-size: 1.1rem;
    color: var(--color-text);
  }

  .blog-content :global(h2),
  .blog-content :global(h3),
  .blog-content :global(h4) {
    font-family: var(--font-display);
    font-weight: 400;
    color: var(--color-heading);
    letter-spacing: -0.02em;
    line-height: 1.15;
    margin-top: 3rem;
    margin-bottom: 1rem;
  }

  .blog-content :global(h2) {
    font-size: 2.1rem;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--color-rule);
  }

  .blog-content :global(h3) {
    font-size: 1.5rem;
  }

  .blog-content :global(h4) {
    font-size: 1.25rem;
    color: var(--color-text-alt);
  }

  .blog-content :global(p) {
    margin-bottom: 1.5rem;
  }

  .blog-content :global(ul),
  .blog-content :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .blog-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .blog-content :global(li::marker) {
    color: var(--color-text-dim);
  }

  /* ---- Blockquotes: 2px accent rule, display serif italic ---- */
  .blog-content :global(blockquote) {
    margin: 2rem 0;
    padding: 0.25rem 0 0.25rem 1.5rem;
    border-left: 2px solid var(--accent);
    background: transparent;
    box-shadow: none;
    border-radius: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.35rem;
    line-height: 1.45;
    letter-spacing: -0.01em;
    color: var(--color-heading);
  }

  .blog-content :global(blockquote p) {
    margin-bottom: 0.75rem;
  }

  .blog-content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  /* ---- Code ---- */
  .blog-content :global(code) {
    font-family: var(--font-mono);
    background-color: var(--color-bg-alt);
    border: 1px solid var(--color-rule);
    padding: 0.12em 0.4em;
    border-radius: var(--radius-sm);
    font-size: 0.85em;
    color: var(--color-heading);
  }

  .blog-content :global(pre) {
    background-color: var(--color-bg-alt) !important;
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-sm);
    margin: 2rem 0;
    padding: 1.25rem 1.4rem;
    overflow-x: auto;
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .blog-content :global(pre code) {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: inherit;
  }

  /* ---- Media ---- */
  .blog-content :global(img) {
    max-width: 100%;
    border-radius: var(--radius-sm);
    margin: 2rem auto;
    display: block;
    box-shadow: none;
  }

  .blog-content :global(iframe) {
    display: block;
    margin: 2rem auto;
    max-width: 100%;
    border-radius: var(--radius-sm);
  }

  .blog-content :global(table) {
    width: 100%;
    display: block;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 2rem 0;
    font-size: 0.95rem;
  }

  .blog-content :global(th),
  .blog-content :global(td) {
    border-bottom: 1px solid var(--color-rule);
    padding: 0.6rem 0.9rem;
    text-align: left;
  }

  .blog-content :global(th) {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
    font-weight: 400;
  }

  /* KaTeX display math can be wider than the measure */
  .blog-content :global(.katex-display) {
    overflow-x: auto;
    overflow-y: hidden;
    padding: 0.25rem 0;
  }

  .blog-content :global(a) {
    color: var(--accent);
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .blog-content :global(a:hover) {
    border-bottom-color: var(--accent);
  }

  .blog-content :global(hr) {
    border: none;
    height: 1px;
    background: var(--color-rule);
    margin: 3rem 0;
  }

  /* ---- Inline contents list (posts that ship their own TOC) ---- */
  .blog-content :global(h2:is([id*="content"], [id*="toc"]) + ul),
  .blog-content :global(h3:is([id*="content"], [id*="toc"]) + ul) {
    border-left: 2px solid var(--color-rule);
    padding: 0.25rem 0 0.25rem 1.25rem;
    margin: 1.5rem 0;
    list-style: none;
  }

  .blog-content :global(h2:is([id*="content"], [id*="toc"]) + ul li),
  .blog-content :global(h3:is([id*="content"], [id*="toc"]) + ul li) {
    list-style: none;
    margin-bottom: 0.4rem;
  }

  .blog-content :global(h2:is([id*="content"], [id*="toc"]) + ul a),
  .blog-content :global(h3:is([id*="content"], [id*="toc"]) + ul a) {
    color: var(--color-text);
  }

  .blog-content :global(h2:is([id*="content"], [id*="toc"]) + ul a:hover),
  .blog-content :global(h3:is([id*="content"], [id*="toc"]) + ul a:hover) {
    color: var(--accent);
  }

  /* ---- Navigation ---- */
  .blog-navigation {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-rule);
  }

  /* ---- Responsive ---- */
  @media (max-width: 768px) {
    .post-layout {
      padding: 0 1.25rem;
    }

    .blog-content {
      font-size: 1.02rem;
    }

    .blog-content :global(h2) {
      font-size: 1.7rem;
    }

    .blog-content :global(h3) {
      font-size: 1.35rem;
    }

    .blog-content :global(blockquote) {
      font-size: 1.15rem;
      padding-left: 1.1rem;
    }

    .blog-content :global(pre) {
      padding: 1rem;
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .back-link .arrow {
      transition: none;
    }

    .back-link:hover .arrow {
      transform: none;
    }
  }
</style>
