---
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  publishedTime?: string;
  tags?: string[];
}

const {
  title = "Antiraedus | Portfolio",
  description = "Personal portfolio website featuring projects, blogs, and more.",
  image = "/profile-top.jpg",
  type = "website",
  publishedTime,
  tags = [],
} = Astro.props;

// Absolute canonical URL for this page
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

// Resolve the OG/Twitter image to an absolute URL against the site origin
const imageURL = new URL(image, Astro.site).toString();
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/x-icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="author" content="Antiraedus" />

		<!-- Canonical -->
		<link rel="canonical" href={canonicalURL} />

		<!-- Open Graph -->
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonicalURL} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:site_name" content="Antiraedus" />
		<meta property="og:locale" content="en_US" />
		<meta property="og:image" content={imageURL} />
		<meta property="og:image:alt" content={title} />

		<!-- Twitter -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={imageURL} />

		{type === 'article' && publishedTime && (
			<meta property="article:published_time" content={publishedTime} />
		)}
		{type === 'article' && tags.map((tag) => (
			<meta property="article:tag" content={tag} />
		))}

		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
		<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" integrity="sha384-n8MVd4RsNIU0tAv4ct0nTaAbDJwPJzDEaqSD1odI+WdtXRGWt2kTvGFasHpSy3SV" crossorigin="anonymous">
		<link rel="alternate" type="application/rss+xml" title="Antiraedus Blog" href="/rss.xml" />
		<title>{title}</title>

		<!-- Cloudflare Web Analytics -->
		<script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "7e948d7032d04cf5a82eb1d230ad60ed"}'></script>
	</head>
	<body>
		<Navbar />
		<main>
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style is:global>
		:root {
		/* ---- Observatory palette (dark is the base; see DESIGN.md) ---- */
		--color-bg: #07070f;
		--color-bg-alt: #0b0b17;
		--color-surface: #10101d;
		--color-bg-card: var(--color-surface);
		--color-heading: #f2f0ff;
		--color-text: #b9b7c9;
		--color-text-alt: #8c8a9e;
		--color-text-dim: #5f5d70;
		--color-rule: rgba(255, 255, 255, 0.1);
		--color-border: var(--color-rule);

		--accent: #f2c27b;
		--accent-soft: rgba(242, 194, 123, 0.12);
		--accent-2: #9d8cff;

		/* ---- Type ---- */
		--font-display: 'Inter', system-ui, -apple-system, sans-serif;
		--font-body: 'Inter', system-ui, -apple-system, sans-serif;
		--font-mono: 'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, monospace;

		/* ---- Layout ---- */
		--container: 1120px;
		--measure: 68ch;
		--radius-sm: 4px;
		--radius-md: 8px;
		--radius-lg: 8px;   /* legacy name, clamped: no more pillowy cards */
		--radius-xl: 8px;   /* legacy name, clamped */

		/* ---- Legacy names, mapped so untouched components keep working ---- */
		--primary-color: var(--accent);
		--secondary-color: var(--accent-2);
		--accent-color: var(--accent);
		--glass-bg: var(--color-surface);
		--glass-border: var(--color-rule);
		--glass-shadow: none;
		--card-hover-shadow: none;
		--glow-primary: none;
		--glow-secondary: none;
		--bg-color: var(--color-bg);
		--text-color: var(--color-text);
		--heading-color: var(--color-heading);
	}

	/* Light theme: parchment + ink + rust. */
	[data-theme="light"] {
		--color-bg: #f4efe6;
		--color-bg-alt: #ece6d9;
		--color-surface: #faf7f1;
		--color-heading: #17140f;
		--color-text: #3a3632;
		--color-text-alt: #6b665f;
		--color-text-dim: #9a948a;
		--color-rule: rgba(23, 20, 15, 0.12);

		--accent: #b4531f;
		--accent-soft: rgba(180, 83, 31, 0.1);
		--accent-2: #5b4bb5;
	}

	html {
		scroll-behavior: smooth;
		scroll-padding-top: 80px;
	}

	/* Decorative bleed (the Astraedus wash, the hero sky) may extend past the
	   viewport horizontally; clip it so nothing ever causes sideways scroll. */
	html, body {
		overflow-x: clip;
	}

	body {
		font-family: var(--font-body);
		font-size: 1.05rem;
		line-height: 1.7;
		-webkit-font-smoothing: antialiased;
		margin: 0;
		padding: 0;
		min-height: 100vh;
		color: var(--color-text);
		background-color: var(--color-bg);
		display: flex;
		flex-direction: column;
		transition: background-color 0.3s ease, color 0.3s ease;
	}

	h1, h2, h3, h4, h5, h6 {
		color: var(--color-heading);
		font-family: var(--font-display);
		font-weight: 700;
		letter-spacing: -0.02em;
		line-height: 1.15;
		transition: color 0.3s ease;
	}

	::selection {
		background: var(--accent);
		color: var(--color-bg);
	}

	main {
		width: 100%;
		margin-top: 0;
		flex: 1;
	}

	/* Reset default margin and padding for common elements */
	*, *::before, *::after {
		box-sizing: border-box;
	}

	img {
		max-width: 100%;
		height: auto;
	}

	/* Global link styling */
	a {
		color: var(--accent);
		transition: all 0.2s ease;
	}

	/* Content links (in markdown content) */
	.blog-content a,
	.project-content a,
	.content a {
		color: var(--primary-color);
		text-decoration: none;
		border-bottom: 1px solid var(--primary-color);
		font-weight: 500;
		transition: all 0.2s ease;
	}

	.blog-content a:hover,
	.project-content a:hover,
	.content a:hover {
		opacity: 0.8;
		transform: translateY(-1px);
	}

	.blog-content a:visited,
	.project-content a:visited,
	.content a:visited {
		color: var(--secondary-color);
		border-bottom-color: var(--secondary-color);
	}

	/* Blockquote styling */
	blockquote {
		margin: 1.5rem 0;
		padding: 1rem 0 1rem 1.5rem;
		border-left: 4px solid var(--accent-color);
		background: transparent;
		font-style: italic;
		color: var(--color-text-alt);
		position: relative;
	}

	blockquote p {
		margin: 0;
	}

	/* Smooth theme transitions for all themed elements */
	*, *::before, *::after {
		transition-property: background-color, border-color, color, box-shadow;
		transition-duration: 0s;
		transition-timing-function: ease;
	}

	html[data-theme-transitioning] *,
	html[data-theme-transitioning] *::before,
	html[data-theme-transitioning] *::after {
		transition-duration: 0.3s !important;
	}
</style>
