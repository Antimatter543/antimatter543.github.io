---
const EMAIL = 'hello@raeduslabs.com';
const DISCORD_HANDLE = 'antiraedus';
---

<section id="contact" class="contact-section">
  <div class="container">
    <header class="sec-head">
      <span class="sec-index">04</span>
      <h2 class="sec-title">Contact Me</h2>
      <p class="sec-lede">Want to talk? Two ways.</p>
    </header>

    <div class="contact-list">
      <a class="contact-item" href={`mailto:${EMAIL}`}>
        <span class="item-label">Email me</span>
        <span class="item-value">{EMAIL}</span>
        <span class="item-hint">opens mail client</span>
      </a>

      <button
        type="button"
        class="contact-item"
        id="discord-copy"
        data-handle={DISCORD_HANDLE}
      >
        <span class="item-label">Message me on Discord</span>
        <span class="item-value">
          <svg class="clyde" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
          </svg>
          <span id="discord-handle">@{DISCORD_HANDLE}</span>
        </span>
        <span class="item-hint" id="discord-hint" aria-live="polite">copy handle</span>
      </button>
    </div>

    <p class="contact-tertiary">
      <a href="https://github.com/Antimatter543" class="arrow-link">Also on GitHub <span class="arrow">&rarr;</span></a>
    </p>
  </div>
</section>

<style>
  .contact-section {
    padding: clamp(5rem, 10vw, 8rem) 0;
    background-color: var(--color-bg-alt);
    border-top: 1px solid var(--color-rule);
  }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- Editorial section header (shared primitive) ---- */
  .sec-head {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0 1rem;
    align-items: baseline;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .sec-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-dim);
    letter-spacing: 0.08em;
  }

  .sec-title {
    grid-column: 2;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .sec-lede {
    grid-column: 2;
    margin: 0.75rem 0 0;
    max-width: 60ch;
    color: var(--color-text-alt);
  }

  /* ---- Two-column hairline list ---- */
  .contact-list {
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-rule);
    border-bottom: 1px solid var(--color-rule);
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 1.75rem 0;
    background: none;
    border: 0;
    border-top: 1px solid var(--color-rule);
    text-align: left;
    text-decoration: none;
    font-family: inherit;
    color: inherit;
    cursor: pointer;
  }

  .contact-item:first-child {
    border-top: 0;
  }

  .contact-item:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 4px;
  }

  .item-label {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--color-text-dim);
  }

  .item-value {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    overflow-wrap: anywhere;
    transition: color 0.3s ease;
  }

  .clyde {
    flex-shrink: 0;
    color: var(--color-text-dim);
    transition: color 0.3s ease;
  }

  .contact-item:hover .item-value,
  .contact-item:focus-visible .item-value {
    color: var(--accent);
  }

  .item-hint {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    transition: color 0.3s ease;
  }

  .item-hint.is-copied {
    color: var(--accent);
  }

  /* ---- Tertiary GitHub link ---- */
  .contact-tertiary {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
  }

  .arrow-link {
    display: inline-block;
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .arrow-link:hover,
  .arrow-link:focus-visible {
    border-bottom-color: var(--accent);
  }

  .arrow-link .arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  .arrow-link:hover .arrow,
  .arrow-link:focus-visible .arrow {
    transform: translateX(4px);
  }

  /* ---- Responsive ---- */
  @media (min-width: 700px) {
    .contact-list {
      grid-template-columns: 1fr 1fr;
    }

    .contact-item {
      border-top: 0;
      padding: 2rem 0;
    }

    .contact-item:first-child {
      padding-right: clamp(2rem, 5vw, 4rem);
    }

    /* the hairline between the two columns */
    .contact-item + .contact-item {
      border-left: 1px solid var(--color-rule);
      padding-left: clamp(2rem, 5vw, 4rem);
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 0 1.25rem;
    }

    .item-value {
      font-size: 1.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow-link .arrow {
      transition: none;
    }

    .arrow-link:hover .arrow,
    .arrow-link:focus-visible .arrow {
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const button = document.getElementById('discord-copy');
    const hint = document.getElementById('discord-hint');
    const handleEl = document.getElementById('discord-handle');
    if (!button || !hint || !handleEl) return;

    const handle = button.dataset.handle || '';
    const idleLabel = hint.textContent || 'copy handle';
    let resetTimer = 0;

    const flash = (message) => {
      hint.textContent = message;
      hint.classList.add('is-copied');
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        hint.textContent = idleLabel;
        hint.classList.remove('is-copied');
      }, 1500);
    };

    const selectHandle = () => {
      const selection = window.getSelection();
      if (!selection) return;
      const range = document.createRange();
      range.selectNodeContents(handleEl);
      selection.removeAllRanges();
      selection.addRange(range);
      flash('Selected');
    };

    button.addEventListener('click', () => {
      if (!navigator.clipboard?.writeText) {
        selectHandle();
        return;
      }
      navigator.clipboard.writeText(handle).then(
        () => flash('Copied!'),
        () => selectHandle()
      );
    });
  })();
</script>
