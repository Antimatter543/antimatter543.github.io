---
const EMAIL = 'hello@raeduslabs.com';
const DISCORD_HANDLE = 'antiraedus';
---

<section id="contact" class="contact-section">
  <div class="container">
    <h2 class="section-title">Contact Me</h2>
    <div class="header-accent"></div>

    <p class="contact-lead">Want to talk? Two ways.</p>

    <div class="contact-cards">
      <a class="contact-card contact-card--email" href={`mailto:${EMAIL}`}>
        <span class="card-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/>
            <polyline points="22,6 12,13 2,6"/>
          </svg>
        </span>
        <span class="card-body">
          <span class="card-label">Email me</span>
          <span class="card-value">{EMAIL}</span>
        </span>
        <span class="card-hint" aria-hidden="true">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"/>
            <polyline points="12 5 19 12 12 19"/>
          </svg>
        </span>
      </a>

      <button
        type="button"
        class="contact-card contact-card--discord"
        id="discord-copy"
        data-handle={DISCORD_HANDLE}
      >
        <span class="card-icon" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor">
            <path d="M20.317 4.3698a19.7913 19.7913 0 0 0-4.8851-1.5152.0741.0741 0 0 0-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 0 0-.0785-.037 19.7363 19.7363 0 0 0-4.8852 1.515.0699.0699 0 0 0-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 0 0 .0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 0 0 .0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 0 0-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 0 1-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 0 1 .0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 0 1 .0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 0 1-.0066.1276 12.2986 12.2986 0 0 1-1.873.8914.0766.0766 0 0 0-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 0 0 .0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 0 0 .0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 0 0-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
          </svg>
        </span>
        <span class="card-body">
          <span class="card-label">Message me on Discord</span>
          <span class="card-value" id="discord-handle">@{DISCORD_HANDLE}</span>
        </span>
        <span class="card-hint" id="discord-hint" aria-live="polite">Copy</span>
      </button>
    </div>

    <div class="contact-tertiary">
      <a href="https://github.com/Antimatter543" class="github-link" aria-label="GitHub profile">
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
        </svg>
        <span>Also on GitHub</span>
        <span class="github-arrow" aria-hidden="true">&rarr;</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 6rem 0;
    background-color: var(--color-bg-alt);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-title {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .header-accent {
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
    margin: 0 auto 2.25rem;
    border-radius: 2px;
  }

  .contact-lead {
    text-align: center;
    color: var(--color-text-alt);
    font-size: 1.05rem;
    line-height: 1.7;
    margin: 0 auto 2.5rem;
    max-width: 34rem;
  }

  /* ---- Cards ---- */
  .contact-cards {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem;
    max-width: 840px;
    margin: 0 auto;
  }

  .contact-card {
    /* per-card accent, overridden below */
    --card-accent: var(--primary-color);
    --card-tint: rgba(100, 255, 218, 0.08);
    --card-edge: rgba(100, 255, 218, 0.28);

    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    gap: 1rem;
    width: 100%;
    box-sizing: border-box;
    margin: 0;
    padding: 1.35rem 1.4rem;
    text-align: left;
    text-decoration: none;
    font-family: inherit;
    cursor: pointer;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-lg);
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1),
                border-color 0.35s cubic-bezier(0.19, 1, 0.22, 1),
                box-shadow 0.35s cubic-bezier(0.19, 1, 0.22, 1),
                background 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .contact-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(130% 150% at 0% 50%, var(--card-tint), transparent 62%);
    opacity: 0.55;
    transition: opacity 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .contact-card:hover::before,
  .contact-card:focus-visible::before {
    opacity: 1;
  }

  .card-icon,
  .card-body,
  .card-hint {
    position: relative;
  }

  .contact-card:hover,
  .contact-card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--card-edge);
    box-shadow: var(--card-hover-shadow);
    outline: none;
  }

  .contact-card--email:hover,
  .contact-card--email:focus-visible {
    box-shadow: var(--card-hover-shadow), var(--glow-primary);
  }

  .contact-card--discord {
    --card-accent: #8b96ff;
    --card-tint: rgba(88, 101, 242, 0.14);
    --card-edge: rgba(88, 101, 242, 0.45);
  }

  .contact-card--discord:hover,
  .contact-card--discord:focus-visible {
    box-shadow: var(--card-hover-shadow), 0 0 20px rgba(88, 101, 242, 0.18);
  }

  :global([data-theme="light"]) .contact-card {
    --card-tint: rgba(8, 145, 178, 0.1);
    --card-edge: rgba(8, 145, 178, 0.35);
  }

  :global([data-theme="light"]) .contact-card--discord {
    --card-accent: #4752c4;
    --card-tint: rgba(88, 101, 242, 0.1);
    --card-edge: rgba(88, 101, 242, 0.4);
  }

  .card-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 48px;
    height: 48px;
    border-radius: var(--radius-md);
    background: var(--card-tint);
    border: 1px solid var(--card-edge);
    color: var(--card-accent);
    transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1),
                background 0.35s ease;
  }

  .contact-card:hover .card-icon,
  .contact-card:focus-visible .card-icon {
    transform: scale(1.06) rotate(-2deg);
  }

  .card-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    flex: 1;
  }

  .card-label {
    font-size: 0.72rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--card-accent);
  }

  .card-value {
    font-size: 1.05rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--color-heading);
    overflow-wrap: anywhere;
    line-height: 1.3;
  }

  .card-hint {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-alt);
    transition: color 0.3s ease, transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .contact-card:hover .card-hint,
  .contact-card:focus-visible .card-hint {
    color: var(--card-accent);
  }

  .contact-card--email:hover .card-hint,
  .contact-card--email:focus-visible .card-hint {
    transform: translateX(3px);
  }

  .card-hint.is-copied {
    color: var(--card-accent);
  }

  /* ---- Tertiary GitHub row ---- */
  .contact-tertiary {
    display: flex;
    justify-content: center;
    margin-top: 2rem;
  }

  .github-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.55rem 1.1rem;
    border-radius: 999px;
    border: 1px solid transparent;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text-alt);
    text-decoration: none;
    transition: color 0.3s ease,
                border-color 0.35s cubic-bezier(0.19, 1, 0.22, 1),
                background 0.35s ease,
                transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .github-link svg {
    fill: currentColor;
    transition: fill 0.3s ease;
  }

  .github-link:hover,
  .github-link:focus-visible {
    color: var(--primary-color);
    border-color: var(--glass-border);
    background: rgba(100, 255, 218, 0.07);
    transform: translateY(-2px);
    outline: none;
  }

  :global([data-theme="light"]) .github-link:hover,
  :global([data-theme="light"]) .github-link:focus-visible {
    background: rgba(8, 145, 178, 0.08);
  }

  .github-arrow {
    transition: transform 0.35s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .github-link:hover .github-arrow,
  .github-link:focus-visible .github-arrow {
    transform: translateX(3px);
  }

  /* ---- Responsive ---- */
  @media (min-width: 700px) {
    .contact-cards {
      grid-template-columns: 1fr 1fr;
      gap: 1.5rem;
    }

    .contact-card {
      padding: 1.6rem 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .section-title {
      font-size: 2rem;
    }
  }

  @media (max-width: 480px) {
    .contact-section {
      padding: 4.5rem 0;
    }

    .container {
      padding: 0 1.25rem;
    }

    .contact-card {
      padding: 1.15rem 1.1rem;
      gap: 0.85rem;
    }

    .card-icon {
      width: 42px;
      height: 42px;
    }

    .card-value {
      font-size: 0.98rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card,
    .contact-card::before,
    .card-icon,
    .card-hint,
    .github-link,
    .github-arrow {
      transition: none;
    }

    .contact-card:hover,
    .contact-card:focus-visible,
    .github-link:hover,
    .github-link:focus-visible,
    .contact-card:hover .card-icon,
    .contact-card:focus-visible .card-icon,
    .contact-card--email:hover .card-hint,
    .github-link:hover .github-arrow {
      transform: none;
    }
  }
</style>

<script>
  (() => {
    const button = document.getElementById('discord-copy');
    const hint = document.getElementById('discord-hint');
    const handleEl = document.getElementById('discord-handle');
    if (!button || !hint || !handleEl) return;

    const handle = button.dataset.handle || '';
    const idleLabel = hint.textContent || 'Copy';
    let resetTimer = 0;

    const flash = (message) => {
      hint.textContent = message;
      hint.classList.add('is-copied');
      window.clearTimeout(resetTimer);
      resetTimer = window.setTimeout(() => {
        hint.textContent = idleLabel;
        hint.classList.remove('is-copied');
      }, 1500);
    };

    const selectHandle = () => {
      const selection = window.getSelection();
      if (!selection) return;
      const range = document.createRange();
      range.selectNodeContents(handleEl);
      selection.removeAllRanges();
      selection.addRange(range);
      flash('Selected');
    };

    button.addEventListener('click', () => {
      if (!navigator.clipboard?.writeText) {
        selectHandle();
        return;
      }
      navigator.clipboard.writeText(handle).then(
        () => flash('Copied!'),
        () => selectHandle()
      );
    });
  })();
</script>
