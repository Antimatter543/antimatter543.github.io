---
---

<nav class="navbar">
  <div class="container">
    <div class="logo">
      <a href="/" aria-label="Antiraedus, home">
        <span class="avatar"><img src="/profile-top.jpg" alt="" width="36" height="36" /></span>
        <span class="wordmark">Antiraedus</span>
      </a>
    </div>
    <button class="mobile-menu-toggle" aria-label="Toggle menu">
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
      <span class="hamburger-line"></span>
    </button>
    <div class="nav-links">
      <a href="/#home" data-section="home">Home</a>
      <a href="/#about" data-section="about">About</a>
      <a href="/#projects" data-section="projects">Projects</a>
      <a href="/blog" data-section="writing">Blog</a>
      <a href="/creatives">Creatives</a>
      <a href="/#contact" data-section="contact">Contact</a>
      <button id="theme-toggle" class="theme-toggle" aria-label="Toggle theme">
        <span class="theme-toggle-icon">
          <svg class="sun-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="5"></circle>
            <path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path>
          </svg>
          <svg class="moon-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
          </svg>
        </span>
      </button>
    </div>
  </div>
</nav>

<style>
  .navbar {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 64px;
    background: transparent;
    border-bottom: 1px solid transparent;
    z-index: 100;
    transition: background-color 0.3s ease, border-color 0.3s ease;
  }

  .navbar.scrolled {
    background: color-mix(in srgb, var(--color-bg) 82%, transparent);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom-color: var(--color-rule);
  }

  .container {
    max-width: var(--container);
    height: 100%;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo a {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.35rem;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .logo a:hover .wordmark {
    color: var(--accent);
  }

  /* Avatar: quiet ring at rest; on hover it tilts, grows, and the ring lights up
     with a slow orbiting arc (same language as the Astraedus emblem). */
  .avatar {
    position: relative;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    flex: none;
    isolation: isolate;
  }

  .avatar::before {
    content: '';
    position: absolute;
    inset: -3px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, transparent 0deg, transparent 230deg, var(--accent) 320deg, transparent 360deg);
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: -1;
  }

  .avatar img {
    display: block;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    object-fit: cover;
    box-shadow: 0 0 0 1px var(--color-rule);
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1), box-shadow 0.35s ease;
  }

  .logo a:hover .avatar::before {
    opacity: 1;
    animation: avatarOrbit 2.4s linear infinite;
  }

  .logo a:hover .avatar img {
    transform: rotate(-10deg) scale(1.12);
    box-shadow: 0 0 0 1px var(--accent), 0 0 18px rgba(242, 194, 123, 0.45);
  }

  :global([data-theme="light"]) .logo a:hover .avatar img {
    box-shadow: 0 0 0 1px var(--accent), 0 0 14px rgba(180, 83, 31, 0.35);
  }

  @keyframes avatarOrbit {
    to { transform: rotate(360deg); }
  }

  @media (prefers-reduced-motion: reduce) {
    .logo a:hover .avatar::before { animation: none; }
    .avatar img { transition: none; }
  }

  .nav-links {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .nav-links a {
    position: relative;
    font-family: var(--font-body);
    font-size: 0.9rem;
    color: var(--color-text-alt);
    text-decoration: none;
    padding-bottom: 2px;
    transition: color 0.3s ease;
  }

  .nav-links a::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: -2px;
    height: 2px;
    background: var(--accent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .nav-links a:hover {
    color: var(--color-heading);
  }

  .nav-links a.is-active {
    color: var(--color-heading);
  }

  .nav-links a.is-active::after {
    opacity: 1;
  }

  .theme-toggle {
    background: none;
    border: 1px solid var(--color-rule);
    border-radius: 50%;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    padding: 0;
    margin-left: 0.5rem;
    color: var(--color-text-alt);
    transition: color 0.3s ease, border-color 0.3s ease;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .theme-toggle-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .sun-icon,
  .moon-icon {
    position: absolute;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  /* Dark mode - show sun icon */
  .sun-icon {
    opacity: 1;
    transform: rotate(0deg);
  }

  .moon-icon {
    opacity: 0;
    transform: rotate(180deg);
  }

  /* Light mode - show moon icon */
  :global([data-theme="light"]) .sun-icon {
    opacity: 0;
    transform: rotate(-180deg);
  }

  :global([data-theme="light"]) .moon-icon {
    opacity: 1;
    transform: rotate(0deg);
  }

  .mobile-menu-toggle {
    display: none;
    flex-direction: column;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    gap: 0.25rem;
  }

  .hamburger-line {
    width: 24px;
    height: 1px;
    background-color: var(--color-text-alt);
    transition: transform 0.3s ease, opacity 0.3s ease, background-color 0.3s ease;
    transform-origin: center;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(1) {
    transform: translateY(5px) rotate(45deg);
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-toggle.active .hamburger-line:nth-child(3) {
    transform: translateY(-5px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 1.25rem;
    }

    .mobile-menu-toggle {
      display: flex;
    }

    .nav-links {
      position: fixed;
      top: 64px;
      left: 0;
      width: 100%;
      background-color: var(--color-bg);
      border-bottom: 1px solid var(--color-rule);
      flex-direction: column;
      padding: 2rem 1rem;
      gap: 1.5rem;
      transform: translateY(-110%);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.3s ease, opacity 0.3s ease, visibility 0.3s ease;
    }

    .nav-links.active {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .nav-links a {
      font-size: 1.05rem;
      text-align: center;
      padding: 0.5rem 0;
    }

    .nav-links a::after {
      left: 50%;
      right: auto;
      width: 2rem;
      transform: translateX(-50%);
      bottom: 0;
    }

    .theme-toggle {
      align-self: center;
      margin-left: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .navbar,
    .nav-links,
    .nav-links a::after,
    .hamburger-line,
    .sun-icon,
    .moon-icon {
      transition: none;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Navbar scroll shadow
    const navbar = document.querySelector('.navbar');
    function updateNavbarScroll() {
      if (window.scrollY > 20) {
        navbar?.classList.add('scrolled');
      } else {
        navbar?.classList.remove('scrolled');
      }
    }
    window.addEventListener('scroll', updateNavbarScroll, { passive: true });
    updateNavbarScroll();

    // Mobile menu functionality
    const mobileMenuToggle = document.querySelector('.mobile-menu-toggle');
    const navLinks = document.querySelector('.nav-links');

    function toggleMobileMenu() {
      mobileMenuToggle.classList.toggle('active');
      navLinks.classList.toggle('active');
    }

    if (mobileMenuToggle) {
      mobileMenuToggle.addEventListener('click', toggleMobileMenu);
    }

    // Close mobile menu when clicking on a nav link
    const navLinkItems = document.querySelectorAll('.nav-links a');
    navLinkItems.forEach(link => {
      link.addEventListener('click', () => {
        if (navLinks.classList.contains('active')) {
          toggleMobileMenu();
        }
      });
    });

    // Close mobile menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!mobileMenuToggle.contains(e.target) && !navLinks.contains(e.target)) {
        if (navLinks.classList.contains('active')) {
          toggleMobileMenu();
        }
      }
    });

    // Active-section underline.
    // On a non-homepage route the active link is the one whose pathname matches;
    // on the homepage it tracks the section currently under the navbar.
    const sectionIds = ['home', 'about', 'projects', 'writing', 'contact'];
    const sectionLinks = new Map();
    navLinkItems.forEach(link => {
      const id = link.dataset.section;
      if (id) sectionLinks.set(id, link);
    });

    function setActive(link) {
      navLinkItems.forEach(l => l.classList.toggle('is-active', l === link));
    }

    const path = window.location.pathname.replace(/\/+$/, '') || '/';
    const isHome = path === '' || path === '/' || path === '/index.html';

    if (!isHome) {
      let pageMatch = null;
      navLinkItems.forEach(link => {
        const href = link.getAttribute('href') || '';
        if (href.startsWith('#') || href.includes('#')) return;
        const linkPath = href.replace(/\/+$/, '') || '/';
        if (linkPath !== '/' && path.startsWith(linkPath)) pageMatch = link;
      });
      if (pageMatch) setActive(pageMatch);
    } else {
      const sections = sectionIds
        .map(id => ({ id, el: document.getElementById(id) }))
        .filter(s => s.el);

      function updateActiveSection() {
        if (!sections.length) return;
        const probe = window.scrollY + 80; // just under the 64px navbar
        let current = sections[0];
        for (const section of sections) {
          if (section.el.offsetTop <= probe) current = section;
        }
        // Last section wins once the page is scrolled to the bottom.
        if (window.innerHeight + window.scrollY >= document.body.scrollHeight - 2) {
          current = sections[sections.length - 1];
        }
        setActive(sectionLinks.get(current.id) || null);
      }

      window.addEventListener('scroll', updateActiveSection, { passive: true });
      window.addEventListener('resize', updateActiveSection, { passive: true });
      updateActiveSection();
    }

    // Theme toggle functionality
    const themeToggle = document.getElementById('theme-toggle');
    const html = document.documentElement;

    // Saved choice wins; otherwise LIGHT is the default (Anti, 2026-09-21).
    const savedTheme = localStorage.getItem('theme');
    const defaultTheme = savedTheme || 'light';

    // Apply the theme
    if (defaultTheme === 'light') {
      html.setAttribute('data-theme', 'light');
    } else {
      html.removeAttribute('data-theme');
    }

    // Toggle theme function
    function toggleTheme() {
      const currentTheme = html.getAttribute('data-theme');
      const newTheme = currentTheme === 'light' ? 'dark' : 'light';

      // Enable transition class for smooth theme switch
      html.setAttribute('data-theme-transitioning', '');

      if (newTheme === 'light') {
        html.setAttribute('data-theme', 'light');
      } else {
        html.removeAttribute('data-theme');
      }

      // Save to localStorage
      localStorage.setItem('theme', newTheme);

      // Remove transition class after animation completes
      setTimeout(() => {
        html.removeAttribute('data-theme-transitioning');
      }, 350);
    }

    // Add click event listener
    if (themeToggle) {
      themeToggle.addEventListener('click', toggleTheme);
    }
  });
</script>
