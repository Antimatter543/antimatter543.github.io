---
import { getFeaturedProjects } from '../utils/projects';

interface Props {
  /** Project slugs to leave out (e.g. ones already shown in a feature panel above). */
  exclude?: string[];
}

const { exclude = [] } = Astro.props;
const featuredProjects = (await getFeaturedProjects()).filter(
  (project) => !exclude.includes(project.slug)
);
---

<div class="row-list">
  {featuredProjects.map((project) => {
    const d = project.data;
    const href = d.hasWriteup
      ? `/projects/${project.slug}`
      : (d.liveUrl || d.externalUrl || d.githubUrl || '#');
    const isInternal = d.hasWriteup;
    return (
      <a
        class="row"
        href={href}
        target={isInternal ? '_self' : '_blank'}
        rel={isInternal ? undefined : 'noopener noreferrer'}
      >
        <span class="row-year">{d.startDate.getFullYear()}</span>
        <span class="row-title">{d.title}</span>
        <span class="row-body">
          <span class="row-desc">{d.description}</span>
          <span class="row-meta">{d.technologies.slice(0, 3).join(' · ')}</span>
        </span>
        <span class="row-arrow" aria-hidden="true">&#8594;</span>
        <span class="row-peek" aria-hidden="true">
          <img src={d.image} alt="" loading="lazy" decoding="async" />
        </span>
      </a>
    );
  })}
</div>

<style>
  .row-list {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr) minmax(0, 1.5fr) 1.25rem;
    gap: 0 1.5rem;
    align-items: baseline;
    padding: 1.4rem 0;
    border-top: 1px solid var(--color-rule);
    text-decoration: none;
    color: inherit;
  }

  .row:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .row:focus-visible {
    outline: 1px solid var(--accent);
    outline-offset: 4px;
  }

  .row-year {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    color: var(--color-text-dim);
  }

  .row-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    transition: color 0.25s ease;
  }

  .row-body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
  }

  .row-desc {
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--color-text-alt);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .row-arrow {
    justify-self: end;
    font-size: 1rem;
    line-height: 1;
    color: var(--color-text-dim);
    transition: transform 0.25s ease, color 0.25s ease;
  }

  .row:hover .row-title,
  .row:focus-visible .row-title {
    color: var(--accent);
  }

  .row:hover .row-arrow,
  .row:focus-visible .row-arrow {
    color: var(--accent);
    transform: translateX(6px);
  }

  /* ---- Cursor-following image peek (desktop pointer only) ---- */
  .row-peek {
    display: none;
  }

  @media (hover: hover) and (min-width: 900px) {
    .row-peek {
      display: block;
      position: fixed;
      top: 0;
      left: 0;
      width: 260px;
      z-index: 5;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
      will-change: transform, opacity;
    }

    .row-peek img {
      display: block;
      width: 100%;
      aspect-ratio: 16 / 10;
      object-fit: cover;
      border-radius: var(--radius-sm);
      border: 1px solid var(--color-rule);
    }
  }

  @media (max-width: 899px) {
    .row {
      grid-template-columns: minmax(0, 1fr) 1.25rem;
      gap: 0.45rem 1rem;
      align-items: start;
      padding: 1.25rem 0;
    }

    .row-year {
      grid-column: 1 / -1;
    }

    .row-title {
      grid-column: 1;
      font-size: 1.35rem;
    }

    .row-arrow {
      grid-column: 2;
      grid-row: 2;
      align-self: center;
    }

    .row-body {
      grid-column: 1 / -1;
    }

    .row-desc {
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 1;
      line-clamp: 1;
      -webkit-box-orient: vertical;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .row-title,
    .row-arrow,
    .row-peek {
      transition: none;
    }

    .row:hover .row-arrow {
      transform: none;
    }
  }
</style>

<script>
  const pointerFine = window.matchMedia('(hover: hover) and (min-width: 900px)');
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (pointerFine.matches && !reducedMotion.matches) {
    const rows = Array.from(document.querySelectorAll<HTMLElement>('.row-list .row'));

    if (rows.length > 0) {
      const PEEK_WIDTH = 260;
      const PEEK_HALF_HEIGHT = 82; // 260px at 16/10 -> ~163px tall
      const EASE = 0.16;

      let active: HTMLElement | null = null;
      let targetX = 0;
      let targetY = 0;
      let currentX = 0;
      let currentY = 0;
      let frame = 0;

      const clampToViewport = (event: PointerEvent | MouseEvent) => {
        targetX = Math.min(event.clientX, window.innerWidth - PEEK_WIDTH - 24);
        targetY = Math.min(
          Math.max(event.clientY, PEEK_HALF_HEIGHT + 8),
          window.innerHeight - PEEK_HALF_HEIGHT - 8
        );
      };

      const render = () => {
        currentX += (targetX - currentX) * EASE;
        currentY += (targetY - currentY) * EASE;
        if (active) {
          active.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(1.5rem, -50%)`;
          frame = requestAnimationFrame(render);
        } else {
          frame = 0;
        }
      };

      const hide = () => {
        if (active) {
          active.style.opacity = '0';
          active = null;
        }
        if (frame) {
          cancelAnimationFrame(frame);
          frame = 0;
        }
      };

      rows.forEach((row) => {
        const peek = row.querySelector<HTMLElement>('.row-peek');
        if (!peek) return;

        row.addEventListener('pointerenter', (event) => {
          if (event.pointerType !== 'mouse') return;
          hide();
          clampToViewport(event);
          // Seed the lerp so the peek fades in where the cursor already is.
          currentX = targetX;
          currentY = targetY;
          active = peek;
          peek.style.transform = `translate3d(${currentX}px, ${currentY}px, 0) translate(1.5rem, -50%)`;
          peek.style.opacity = '1';
          frame = requestAnimationFrame(render);
        });

        row.addEventListener('pointermove', (event) => {
          if (active !== peek) return;
          clampToViewport(event);
        });

        row.addEventListener('pointerleave', hide);
      });

      window.addEventListener('scroll', hide, { passive: true });
      window.addEventListener('blur', hide);
    }
  }
</script>
