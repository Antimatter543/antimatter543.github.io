---
import AstraedusShowcase from './AstraedusShowcase.astro';
import ShippedAppsRow from './ShippedAppsRow.astro';
import ProjectGrid from './ProjectGrid.astro';

// Nudge and SoulSync get the feature panels above the list, so keep them out
// of the row list to avoid showing them twice.
const SHOWCASED_SLUGS = ['nudge', 'soulsync'];
---

<section id="projects" class="projects-section">
  <div class="container">
    <header class="sec-head">
      <span class="sec-index">02</span>
      <h2 class="sec-title">Featured Projects</h2>
    </header>

    <AstraedusShowcase />
    <ShippedAppsRow />

    <p class="list-label">More projects</p>
    <ProjectGrid exclude={SHOWCASED_SLUGS} />

    <div class="list-footer">
      <a href="/projects" class="arrow-link">All projects <span aria-hidden="true">&#8594;</span></a>
    </div>
  </div>
</section>

<style>
  .projects-section {
    padding: clamp(5rem, 10vw, 8rem) 0;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-rule);
  }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- Editorial section header (shared primitive) ---- */
  .sec-head {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0 1rem;
    align-items: baseline;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .sec-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-dim);
    letter-spacing: 0.08em;
  }

  .sec-title {
    grid-column: 2;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  /* ---- Quiet mono eyebrow above the row list ---- */
  .list-label {
    margin: 0 0 0.25rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  /* ---- Arrow link under the list ---- */
  .list-footer {
    display: flex;
    justify-content: flex-end;
    margin-top: 1.75rem;
  }

  .arrow-link {
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  .arrow-link span {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .arrow-link:hover {
    border-bottom-color: var(--accent);
  }

  .arrow-link:hover span {
    transform: translateX(4px);
  }

  @media (max-width: 600px) {
    .container {
      padding: 0 1.25rem;
    }

    .sec-head {
      grid-template-columns: 2.75rem 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow-link,
    .arrow-link span {
      transition: none;
    }

    .arrow-link:hover span {
      transform: none;
    }
  }
</style>
