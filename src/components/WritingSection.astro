---
import { getCollection } from 'astro:content';

// Get all blog posts, filter out drafts and any explicitly hidden from this section
const posts = await getCollection('blog', ({ data }) => {
  return !data.draft && !data.hideFromLatest;
});

// Sort posts by publication date (newest first)
const sortedPosts = posts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Calculate reading time from word count
function getReadingTime(body: string): number {
  const wordsPerMinute = 200;
  const words = body.trim().split(/\s+/).length;
  return Math.max(1, Math.ceil(words / wordsPerMinute));
}

// Featured (latest) + up to 3 in the row list
const [featuredPost, ...remainingPosts] = sortedPosts;
const rowPosts = remainingPosts.slice(0, 3);

const shortDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
---

{featuredPost && (
  <section id="writing" class="writing-section">
    <div class="container">
      <header class="sec-head">
        <span class="sec-index">03</span>
        <h2 class="sec-title">Latest Writing</h2>
      </header>

      {/* Feature panel — the latest post */}
      <a href={`/blog/${featuredPost.slug}`} class="feature" data-has-image={featuredPost.data.heroImage ? 'true' : 'false'}>
        {featuredPost.data.heroImage && (
          <div class="feature-image">
            <img src={featuredPost.data.heroImage} alt={featuredPost.data.title} loading="lazy" />
          </div>
        )}
        <div class="feature-body">
          <h3 class="feature-title">{featuredPost.data.title}</h3>
          <p class="meta">
            <time datetime={featuredPost.data.pubDate.toISOString()}>{shortDate(featuredPost.data.pubDate)}</time>
            {' · '}{getReadingTime(featuredPost.body)} min read
          </p>
          <p class="feature-desc">{featuredPost.data.description}</p>
          {featuredPost.data.tags && featuredPost.data.tags.length > 0 && (
            <p class="meta feature-tags">{featuredPost.data.tags.join(' · ')}</p>
          )}
          <span class="arrow-link">Read article <span class="arrow">&rarr;</span></span>
        </div>
      </a>

      {/* Row list — the rest */}
      {rowPosts.length > 0 && (
        <div class="rows">
          {rowPosts.map((post) => (
            <a class="row" href={`/blog/${post.slug}`}>
              <span class="row-meta">
                <time datetime={post.data.pubDate.toISOString()}>{shortDate(post.data.pubDate)}</time>
              </span>
              <span class="row-title">{post.data.title}</span>
              <span class="row-desc">{post.data.description}</span>
              <span class="row-arrow">&rarr;</span>
            </a>
          ))}
        </div>
      )}

      <p class="writing-more">
        <a href="/blog" class="arrow-link">Read the blog <span class="arrow">&rarr;</span></a>
      </p>
    </div>
  </section>
)}

<style>
  .writing-section {
    padding: clamp(5rem, 10vw, 8rem) 0;
    background-color: var(--color-bg);
    border-top: 1px solid var(--color-rule);
  }

  .container {
    max-width: var(--container);
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ---- Editorial section header (shared primitive) ---- */
  .sec-head {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 0 1rem;
    align-items: baseline;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .sec-index {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-dim);
    letter-spacing: 0.08em;
  }

  .sec-title {
    grid-column: 2;
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(2.2rem, 4vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  /* ---- Mono meta line (shared primitive) ---- */
  .meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--color-text-dim);
    letter-spacing: 0.04em;
    margin: 0;
  }

  /* ---- Arrow link (shared primitive) ---- */
  .arrow-link {
    display: inline-block;
    color: var(--accent);
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.3s ease;
  }

  .arrow-link .arrow {
    display: inline-block;
    transition: transform 0.3s ease;
  }

  /* ---- Feature panel ---- */
  .feature {
    display: grid;
    grid-template-columns: 40% minmax(0, 1fr);
    gap: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.3s ease;
  }

  .feature[data-has-image='false'] {
    grid-template-columns: 1fr;
  }

  .feature:hover {
    border-color: var(--accent-soft);
  }

  .feature-image {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
    min-width: 0;
  }

  .feature-image img {
    max-width: 100%;
    max-height: 320px;
    object-fit: contain;
    border-radius: var(--radius-sm);
    display: block;
  }

  .feature-body {
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.75rem;
    min-width: 0;
  }

  .feature-title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 2rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    transition: color 0.3s ease;
  }

  .feature:hover .feature-title {
    color: var(--accent);
  }

  .feature-desc {
    margin: 0;
    color: var(--color-text-alt);
    font-size: 1rem;
    line-height: 1.7;
  }

  .feature-tags {
    color: var(--color-text-dim);
  }

  .feature .arrow-link {
    margin-top: 0.25rem;
    align-self: flex-start;
  }

  .feature:hover .arrow-link {
    border-bottom-color: var(--accent);
  }

  .feature:hover .arrow-link .arrow {
    transform: translateX(4px);
  }

  /* ---- Row list (shared primitive) ---- */
  .rows {
    margin-top: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--color-rule);
  }

  .row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) minmax(0, 1.4fr) auto;
    gap: 0 1.5rem;
    align-items: baseline;
    padding: 1.4rem 0;
    border-top: 1px solid var(--color-rule);
    text-decoration: none;
    color: inherit;
  }

  .row-meta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    color: var(--color-text-dim);
  }

  .row-title {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 1.5rem;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--color-heading);
    transition: color 0.3s ease;
  }

  .row-desc {
    color: var(--color-text-alt);
    font-size: 0.95rem;
    line-height: 1.6;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .row-arrow {
    color: var(--color-text-dim);
    transition: transform 0.3s ease, color 0.3s ease;
  }

  .row:hover .row-title {
    color: var(--accent);
  }

  .row:hover .row-arrow {
    color: var(--accent);
    transform: translateX(6px);
  }

  /* ---- Read the blog ---- */
  .writing-more {
    margin: clamp(2rem, 4vw, 3rem) 0 0;
  }

  .writing-more .arrow-link:hover {
    border-bottom-color: var(--accent);
  }

  .writing-more .arrow-link:hover .arrow {
    transform: translateX(4px);
  }

  /* ---- Responsive ---- */
  @media (max-width: 860px) {
    .feature,
    .feature[data-has-image='true'] {
      grid-template-columns: 1fr;
    }

    .feature-image {
      padding: 1.25rem 1.25rem 0;
    }

    .feature-image img {
      max-height: 220px;
    }

    .feature-title {
      font-size: 1.6rem;
    }

    .row {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.4rem 1rem;
    }

    .row-meta {
      grid-column: 1 / -1;
    }

    .row-desc {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .container {
      padding: 0 1.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .arrow,
    .row-arrow {
      transition: none;
    }

    .feature:hover .arrow-link .arrow,
    .writing-more .arrow-link:hover .arrow,
    .row:hover .row-arrow {
      transform: none;
    }
  }
</style>
