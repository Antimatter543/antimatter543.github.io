---
// The headline "featured project": Astraedus, the autonomous agent.
// Rendered as one full-width row at the top of Featured Projects.
// The ouroboros is painted through a CSS mask so the SAME silhouette can be
// filled with a calm monochrome at rest and a live fire gradient on hover.
const GITHUB_URL = 'https://github.com/astraedus';
const TAGLINE =
  "Autonomous agent built on top of determinism principles so I can build things to help people where I otherwise couldn't.";
---

<a
  href={GITHUB_URL}
  class="astra-card"
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Astraedus on GitHub"
>
  <span class="astra-wash astra-wash-cool" aria-hidden="true"></span>
  <span class="astra-wash astra-wash-warm" aria-hidden="true"></span>

  <div class="astra-emblem" aria-hidden="true">
    <span class="astra-ring"></span>
    <span class="astra-ring astra-ring-inner"></span>
    <div class="ouro-stack">
      <span class="ouro ouro-glow"></span>
      <span class="ouro ouro-mono"></span>
      <span class="ouro ouro-fire"></span>
    </div>
    <span class="ember e1"></span>
    <span class="ember e2"></span>
    <span class="ember e3"></span>
    <span class="ember e4"></span>
    <span class="ember e5"></span>
    <span class="ember e6"></span>
  </div>

  <div class="astra-body">
    <span class="astra-eyebrow">
      <span class="eyebrow-dot"></span>
      Featured &middot; Autonomous agent
    </span>
    <h3 class="astra-name">Astraedus</h3>
    <p class="astra-tagline">{TAGLINE}</p>
    <span class="astra-cta">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.2 1.9 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z"/>
      </svg>
      github.com/astraedus
      <svg class="cta-arrow" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M12 5l7 7-7 7"/>
      </svg>
    </span>
  </div>
</a>

<style>
  /* ------------------------------------------------------------------ */
  /* Palette: rest = cool monochrome (site teal), hover = fire.            */
  /* ------------------------------------------------------------------ */
  .astra-card {
    --ouro-mono: #f4f7fb;
    --ouro-glow: rgba(100, 255, 218, 0.85);
    --ring-cool: rgba(100, 255, 218, 0.55);
    --ring-warm: rgba(255, 138, 0, 0.9);
    --fire-a: #6a0000;
    --fire-b: #ff2a00;
    --fire-c: #ff8a00;
    --fire-d: #ffd166;
    --card-border-hot: rgba(255, 138, 0, 0.45);

    position: relative;
    display: grid;
    grid-template-columns: minmax(240px, 360px) 1fr;
    align-items: center;
    gap: clamp(2rem, 5vw, 4.5rem);
    padding: clamp(2rem, 4vw, 3.5rem);
    margin-bottom: 3.5rem;
    text-decoration: none;
    color: inherit;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    box-shadow: var(--glass-shadow);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    overflow: hidden;
    isolation: isolate;
    transition:
      transform 0.6s cubic-bezier(0.19, 1, 0.22, 1),
      border-color 0.6s ease,
      box-shadow 0.6s ease;
  }

  :global([data-theme="light"]) .astra-card {
    --ouro-mono: #0f172a;
    --ouro-glow: rgba(8, 145, 178, 0.7);
    --ring-cool: rgba(8, 145, 178, 0.45);
  }

  .astra-card:hover,
  .astra-card:focus-visible {
    transform: translateY(-6px);
    border-color: var(--card-border-hot);
    box-shadow:
      0 30px 80px rgba(255, 90, 0, 0.18),
      0 10px 30px rgba(0, 0, 0, 0.35),
      inset 0 0 0 1px rgba(255, 170, 60, 0.12);
    outline: none;
  }

  /* Background washes: two layers cross-faded so the gradient "animates". */
  .astra-wash {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: -1;
    transition: opacity 0.7s ease;
  }

  .astra-wash-cool {
    opacity: 1;
    background:
      radial-gradient(60% 80% at 22% 50%, rgba(100, 255, 218, 0.1), transparent 70%),
      radial-gradient(40% 60% at 90% 10%, rgba(168, 85, 247, 0.08), transparent 70%);
  }

  :global([data-theme="light"]) .astra-wash-cool {
    background:
      radial-gradient(60% 80% at 22% 50%, rgba(8, 145, 178, 0.1), transparent 70%),
      radial-gradient(40% 60% at 90% 10%, rgba(124, 58, 237, 0.07), transparent 70%);
  }

  .astra-wash-warm {
    opacity: 0;
    background:
      radial-gradient(65% 90% at 22% 55%, rgba(255, 110, 0, 0.26), transparent 70%),
      radial-gradient(50% 70% at 85% 0%, rgba(255, 30, 0, 0.14), transparent 70%),
      linear-gradient(180deg, rgba(20, 4, 0, 0.35), transparent 60%);
  }

  :global([data-theme="light"]) .astra-wash-warm {
    background:
      radial-gradient(65% 90% at 22% 55%, rgba(255, 120, 0, 0.2), transparent 70%),
      radial-gradient(50% 70% at 85% 0%, rgba(255, 60, 0, 0.1), transparent 70%);
  }

  .astra-card:hover .astra-wash-cool,
  .astra-card:focus-visible .astra-wash-cool {
    opacity: 0;
  }

  .astra-card:hover .astra-wash-warm,
  .astra-card:focus-visible .astra-wash-warm {
    opacity: 1;
  }

  /* ---- Emblem ---- */
  .astra-emblem {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    display: grid;
    place-items: center;
  }

  /* Orbiting arc rings, drawn with a conic gradient masked to a thin ring. */
  .astra-ring {
    position: absolute;
    inset: 2%;
    border-radius: 50%;
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 250deg,
      var(--ring-cool) 320deg,
      transparent 360deg
    );
    -webkit-mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
    mask: radial-gradient(farthest-side, transparent calc(100% - 2px), #000 calc(100% - 1px));
    animation: astraSpin 16s linear infinite;
    opacity: 0.9;
    transition: opacity 0.6s ease;
  }

  .astra-ring-inner {
    inset: 9%;
    animation: astraSpin 11s linear infinite reverse;
    opacity: 0.45;
  }

  .astra-card:hover .astra-ring,
  .astra-card:focus-visible .astra-ring {
    background: conic-gradient(
      from 0deg,
      transparent 0deg,
      transparent 200deg,
      var(--ring-warm) 300deg,
      #ffd166 330deg,
      transparent 360deg
    );
    animation-duration: 3.5s;
    opacity: 1;
  }

  .astra-card:hover .astra-ring-inner,
  .astra-card:focus-visible .astra-ring-inner {
    animation-duration: 2.4s;
    opacity: 0.8;
  }

  .ouro-stack {
    position: relative;
    width: 76%;
    aspect-ratio: 1 / 1;
    animation: astraFloat 6s ease-in-out infinite;
    transition: transform 1.2s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .astra-card:hover .ouro-stack,
  .astra-card:focus-visible .ouro-stack {
    transform: rotate(-10deg) scale(1.05);
  }

  /* Every ouro layer shares the silhouette via mask; only the paint differs. */
  .ouro {
    position: absolute;
    inset: 0;
    -webkit-mask: url('/images/astraedus-ouroboros.svg') center / contain no-repeat;
    mask: url('/images/astraedus-ouroboros.svg') center / contain no-repeat;
  }

  .ouro-glow {
    background: var(--ouro-glow);
    filter: blur(18px);
    opacity: 0.4;
    transform: scale(1.06);
    transition: background-color 0.7s ease, opacity 0.7s ease, filter 0.7s ease;
  }

  .ouro-mono {
    background: var(--ouro-mono);
    transition: opacity 0.6s ease;
  }

  .ouro-fire {
    opacity: 0;
    background: linear-gradient(
      160deg,
      var(--fire-a) 0%,
      var(--fire-b) 22%,
      var(--fire-c) 46%,
      var(--fire-d) 60%,
      var(--fire-c) 74%,
      var(--fire-b) 90%,
      var(--fire-a) 100%
    );
    background-size: 260% 260%;
    animation: fireShift 2.6s ease-in-out infinite alternate;
    transition: opacity 0.6s ease;
  }

  .astra-card:hover .ouro-mono,
  .astra-card:focus-visible .ouro-mono {
    opacity: 0;
  }

  .astra-card:hover .ouro-fire,
  .astra-card:focus-visible .ouro-fire {
    opacity: 1;
  }

  .astra-card:hover .ouro-glow,
  .astra-card:focus-visible .ouro-glow {
    background: #ff6a00;
    opacity: 0.85;
    filter: blur(26px);
  }

  /* Embers: hidden at rest, drift upward on hover. */
  .ember {
    position: absolute;
    bottom: 18%;
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: #ffb347;
    box-shadow: 0 0 10px 2px rgba(255, 140, 0, 0.7);
    opacity: 0;
    pointer-events: none;
  }

  .e1 { left: 22%; }
  .e2 { left: 34%; width: 3px; height: 3px; }
  .e3 { left: 48%; }
  .e4 { left: 60%; width: 4px; height: 4px; }
  .e5 { left: 72%; }
  .e6 { left: 82%; width: 3px; height: 3px; }

  .astra-card:hover .ember,
  .astra-card:focus-visible .ember {
    animation: emberRise 2.2s ease-out infinite;
  }

  .e2 { animation-delay: 0.4s !important; }
  .e3 { animation-delay: 0.9s !important; }
  .e4 { animation-delay: 0.2s !important; }
  .e5 { animation-delay: 1.3s !important; }
  .e6 { animation-delay: 0.7s !important; }

  /* ---- Body ---- */
  .astra-body {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    min-width: 0;
  }

  .astra-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--primary-color);
    transition: color 0.5s ease;
  }

  .eyebrow-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 10px currentColor;
    animation: pulse 2.4s ease-in-out infinite;
  }

  .astra-name {
    margin: 0;
    font-size: clamp(2.6rem, 5.5vw, 4.4rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.035em;
    color: var(--color-heading);
    transition: color 0.5s ease, text-shadow 0.5s ease;
  }

  .astra-tagline {
    margin: 0;
    max-width: 52ch;
    font-size: clamp(1.02rem, 1.4vw, 1.2rem);
    line-height: 1.7;
    color: var(--color-text);
  }

  .astra-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.4rem;
    width: fit-content;
    padding: 0.65rem 1.1rem;
    border-radius: var(--radius-md);
    font-size: 0.92rem;
    font-weight: 500;
    color: var(--primary-color);
    background: rgba(100, 255, 218, 0.07);
    border: 1px solid rgba(100, 255, 218, 0.2);
    transition: all 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }

  :global([data-theme="light"]) .astra-cta {
    background: rgba(8, 145, 178, 0.07);
    border-color: rgba(8, 145, 178, 0.2);
  }

  .cta-arrow {
    transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .astra-card:hover .astra-eyebrow,
  .astra-card:focus-visible .astra-eyebrow {
    color: #ffb066;
  }

  .astra-card:hover .astra-name,
  .astra-card:focus-visible .astra-name {
    color: #fff3e6;
    text-shadow: 0 0 28px rgba(255, 140, 0, 0.35);
  }

  :global([data-theme="light"]) .astra-card:hover .astra-name,
  :global([data-theme="light"]) .astra-card:focus-visible .astra-name {
    color: #3b0a00;
    text-shadow: 0 0 22px rgba(255, 140, 0, 0.25);
  }

  .astra-card:hover .astra-cta,
  .astra-card:focus-visible .astra-cta {
    color: #1a0800;
    background: linear-gradient(90deg, #ffb347, #ff7a00);
    border-color: transparent;
    box-shadow: 0 8px 24px rgba(255, 122, 0, 0.35);
  }

  .astra-card:hover .cta-arrow,
  .astra-card:focus-visible .cta-arrow {
    transform: translateX(4px);
  }

  /* ---- Keyframes ---- */
  @keyframes astraSpin {
    to { transform: rotate(360deg); }
  }

  @keyframes astraFloat {
    0%, 100% { translate: 0 0; }
    50% { translate: 0 -8px; }
  }

  @keyframes fireShift {
    0% { background-position: 0% 0%; }
    100% { background-position: 100% 100%; }
  }

  @keyframes emberRise {
    0% { opacity: 0; transform: translateY(0) scale(0.6); }
    15% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-140px) translateX(12px) scale(1.1); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 0.55; }
    50% { opacity: 1; }
  }

  /* ---- Responsive ---- */
  @media (max-width: 820px) {
    .astra-card {
      grid-template-columns: 1fr;
      text-align: center;
      gap: 1.5rem;
    }

    .astra-emblem {
      width: min(62vw, 280px);
      margin: 0 auto;
    }

    .astra-body {
      align-items: center;
    }

    .astra-name {
      font-size: clamp(2.4rem, 11vw, 3.4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .astra-ring,
    .astra-ring-inner,
    .ouro-stack,
    .ouro-fire,
    .eyebrow-dot,
    .ember {
      animation: none !important;
    }

    .astra-card,
    .ouro-stack,
    .cta-arrow {
      transition: none;
    }

    .astra-card:hover {
      transform: none;
    }
  }
</style>
