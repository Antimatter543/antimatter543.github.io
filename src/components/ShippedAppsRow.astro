---
import { getEntry } from 'astro:content';

const nudge = await getEntry('projects', 'nudge');
const soulsync = await getEntry('projects', 'soulsync');

// Rendered as the "shipped apps" panels inside Featured Projects (two feature
// panels under the Astraedus showcase). Presentation copy lives here; links and
// images stay single-sourced from the projects collection so they never drift
// out of sync with the project pages.
const apps = [
  {
    entry: nudge,
    name: 'Nudge',
    tagline: 'Break the scroll, take back your time.',
    leadBadge: '500+ downloads',
    badges: ['Open source', 'Free forever', 'Zero internet permission'],
    why: `I built Nudge over a weekend because I hate letting trillion dollar companies have unfettered access to my increasingly-fragmented attention so that I may become a better consumer for their products.`,
    blurb: `Allows hard locks, time locks and "Just wait 10 seconds" locks for apps. Long enough to break the autopilot loop but short enough so your ego doesn't let you uninstall it. It can also kill Reels, Shorts and the TikTok For You feed without blocking the whole app.`,
    ctaLabel: 'Get it on Google Play',
  },
  {
    entry: soulsync,
    name: 'SoulSync',
    tagline: 'A mood tracker that never phones home.',
    leadBadge: '100% on-device',
    badges: ['Open source', 'Free forever'],
    why: `I just really like data. You know, nature is apparently my top activity that results in my mood being higher?`,
    blurb: `Log mood, activities, notes and photos, and it surfaces honest patterns from your own history: real correlations with p-values and sample sizes, not vibes. Heart rate and HRV can go in the mix too. Everything lives in local SQLite, with JSON export if you ever want to walk away.`,
    ctaLabel: 'Get it on Google Play',
  },
].filter((app) => app.entry);
---

<div id="apps" class="apps-row">
  <header class="apps-head">
    <p class="apps-eyebrow">Shipped apps</p>
    <p class="apps-intro">
      Two Android apps, both free and both open source, built because I wanted them to exist and wanted everyone to be able to access this.
    </p>
  </header>

  <div class="apps-panels">
    {apps.map((app) => (
      <article class="app-panel">
        <img
          class="app-banner"
          src={app.entry!.data.image}
          alt={app.entry!.data.imageAlt}
          loading="eager"
          decoding="async"
        />

        <div class="app-body">
          <h3 class="app-name">{app.name}</h3>
          <p class="app-tagline">{app.tagline}</p>

          <p class="app-meta">{[app.leadBadge, ...app.badges].join(' · ')}</p>

          <blockquote class="app-why">{app.why}</blockquote>

          <p class="app-blurb">{app.blurb}</p>

          <div class="app-actions">
            {(app.entry!.data.liveUrl ?? app.entry!.data.externalUrl) && (
              <a
                href={app.entry!.data.liveUrl ?? app.entry!.data.externalUrl}
                class="app-cta"
                target="_blank"
                rel="noopener noreferrer"
              >
                <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M3.6 2.3a1 1 0 0 0-.5.9v17.6a1 1 0 0 0 .5.9l9.3-9.7-9.3-9.7Zm10.7 8.3 2.9-3L5.9 1.5a1 1 0 0 0-.4-.1l8.8 9.2Zm0 2.8L5.5 22.6a1 1 0 0 0 .4-.1l11.3-6.1-2.9-3Zm4.2-1.4 3-1.6c.8-.4.8-1.6 0-2l-3-1.6-3.3 3.3 3.3 3.3Z"/>
                </svg>
                {app.ctaLabel}
              </a>
            )}
            {app.entry!.data.githubUrl && (
              <a href={app.entry!.data.githubUrl} class="arrow-link" target="_blank" rel="noopener noreferrer">
                Source <span aria-hidden="true">&#8594;</span>
              </a>
            )}
            {app.entry!.data.blogUrl && (
              <a href={app.entry!.data.blogUrl} class="arrow-link">
                Write-up <span aria-hidden="true">&#8594;</span>
              </a>
            )}
          </div>
        </div>
      </article>
    ))}
  </div>
</div>

<style>
  .apps-row {
    margin-bottom: clamp(3.5rem, 7vw, 5rem);
  }

  /* ---- Left-aligned mono eyebrow + intro ---- */
  .apps-head {
    margin-bottom: 1.75rem;
  }

  .apps-eyebrow {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-dim);
  }

  .apps-intro {
    max-width: 60ch;
    margin: 0.75rem 0 0;
    color: var(--color-text-alt);
  }

  /* ---- Flat feature panels ---- */
  .apps-panels {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    align-items: stretch;
  }

  .app-panel {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-rule);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .app-banner {
    display: block;
    width: 100%;
    aspect-ratio: 1024 / 500;
    object-fit: cover;
    border-bottom: 1px solid var(--color-rule);
  }

  .app-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
    flex: 1;
  }

  .app-name {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.6rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--color-heading);
  }

  .app-tagline {
    margin: -0.55rem 0 0;
    font-style: italic;
    font-size: 1rem;
    color: var(--accent);
  }

  .app-meta {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    line-height: 1.6;
    color: var(--color-text-dim);
  }

  .app-why {
    margin: 0;
    padding: 0.1rem 0 0.1rem 1rem;
    border-left: 2px solid var(--accent);
    background: transparent;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.45;
    color: var(--color-text);
  }

  .app-blurb {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-alt);
  }

  /* ---- Actions: one filled store CTA + arrow links ---- */
  .app-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .app-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-md);
    background: var(--accent);
    color: var(--color-bg);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    transition: filter 0.25s ease;
  }

  .app-cta:hover {
    filter: brightness(1.08);
  }

  .arrow-link {
    color: var(--accent);
    font-size: 0.9rem;
    font-weight: 500;
    text-decoration: none;
    border-bottom: 1px solid transparent;
    transition: border-color 0.25s ease;
  }

  .arrow-link span {
    display: inline-block;
    transition: transform 0.25s ease;
  }

  .arrow-link:hover {
    border-bottom-color: var(--accent);
  }

  .arrow-link:hover span {
    transform: translateX(4px);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .apps-panels {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 600px) {
    .app-body {
      padding: 1.35rem;
    }

    .app-name {
      font-size: 1.45rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-cta,
    .arrow-link,
    .arrow-link span {
      transition: none;
    }

    .arrow-link:hover span {
      transform: none;
    }
  }
</style>
