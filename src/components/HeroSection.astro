---
// The first screen: a living sky and one line in Anti's own words.
// Copy is lifted verbatim from the About section so the voice is his, not ours.
---

<section id="home" class="hero">
  <canvas class="sky" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <p class="hero-eyebrow">Antiraedus <span class="sep">·</span> systems, space &amp; human agency</p>
    <h1 class="hero-line">I like <em>romanticising</em> life.</h1>
    <p class="hero-sub">
      I enjoy learning about systems, deconstructing every component of them to build better world models.
      I make things that give people back their attention and agency.
    </p>
  </div>
  <a href="#manifesto" class="scroll-cue" aria-label="Scroll to the manifesto">
    <span class="cue-text">Scroll</span>
    <span class="cue-line"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 6rem 1.5rem 7rem;
    overflow: hidden;
    background: var(--color-bg);
    isolation: isolate;
  }

  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    max-width: 62rem;
    text-align: center;
    animation: rise 1.4s cubic-bezier(0.19, 1, 0.22, 1) both;
  }

  .hero-eyebrow {
    margin: 0 0 1.75rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-alt);
  }

  .hero-eyebrow .sep {
    color: var(--accent);
    margin: 0 0.4rem;
  }

  .hero-line {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 400;
    font-size: clamp(3rem, 9vw, 7.5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--color-heading);
    text-wrap: balance;
  }

  .hero-line em {
    font-style: italic;
    color: var(--accent);
  }

  .hero-sub {
    margin: 2rem auto 0;
    max-width: 44ch;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.7;
    color: var(--color-text-alt);
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 2.25rem;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .scroll-cue:hover { color: var(--accent); }

  .cue-line {
    display: block;
    width: 1px;
    height: 44px;
    background: linear-gradient(to bottom, currentColor, transparent);
    animation: cue 2.4s ease-in-out infinite;
    transform-origin: top;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes cue {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  @media (max-width: 600px) {
    .hero { padding: 5rem 1.25rem 6rem; }
    .hero-eyebrow { font-size: 0.68rem; letter-spacing: 0.1em; }
    .hero-sub { margin-top: 1.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-inner, .cue-line { animation: none; }
  }
</style>

<script>
  import { ObservatorySky } from '../utils/observatory-sky.js';
  const canvas = document.querySelector<HTMLCanvasElement>('.hero .sky');
  if (canvas) new ObservatorySky(canvas);
</script>
