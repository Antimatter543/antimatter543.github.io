---
// The first screen: the living sky behind the xkcd strip Anti has always opened
// with, and the line about what he does underneath it.
---

<section id="home" class="hero">
  <canvas class="sky" aria-hidden="true"></canvas>
  <div class="hero-inner">
    <a class="strip" href="https://xkcd.com/137/" target="_blank" rel="noopener noreferrer" aria-label="xkcd 137, Dreams">
      <img src="/images/dreams.png" alt="xkcd 137, 'Dreams'" width="550" height="757" fetchpriority="high" />
    </a>
    <p class="hero-eyebrow">Antiraedus <span class="sep">·</span> systems, space &amp; human agency</p>
    <p class="hero-sub">
      I enjoy learning about systems, deconstructing every component of them to build better world models.
      I make things that give people back their attention and agency.
    </p>
  </div>
  <a href="#about" class="scroll-cue" aria-label="Scroll to About">
    <span class="cue-text">Scroll to explore</span>
    <span class="cue-line"></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    place-items: center;
    padding: 6rem 1.5rem 6.5rem;
    overflow: hidden;
    background: var(--color-bg);
    isolation: isolate;
  }

  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    max-width: 62rem;
    animation: rise 1.4s cubic-bezier(0.19, 1, 0.22, 1) both;
  }

  .strip {
    display: block;
    line-height: 0;
    margin-bottom: 2rem;
  }

  .strip img {
    display: block;
    width: auto;
    height: auto;
    max-width: min(90vw, 560px);
    max-height: 62vh;
    border-radius: var(--radius-sm);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.55);
    animation: dreamFloat 4s ease-in-out infinite alternate;
  }

  .hero-eyebrow {
    margin: 0 0 0.9rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-alt);
  }

  .hero-eyebrow .sep {
    color: var(--accent);
    margin: 0 0.4rem;
  }

  .hero-sub {
    margin: 0 auto;
    max-width: 44ch;
    font-size: clamp(1rem, 1.3vw, 1.15rem);
    line-height: 1.7;
    color: var(--color-text-alt);
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 1.5rem;
    transform: translateX(-50%);
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--color-text-dim);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    transition: color 0.3s ease;
  }

  .scroll-cue:hover { color: var(--accent); }

  .cue-line {
    display: block;
    width: 1px;
    height: 36px;
    background: linear-gradient(to bottom, currentColor, transparent);
    animation: cue 2.4s ease-in-out infinite;
    transform-origin: top;
  }

  @keyframes rise {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @keyframes dreamFloat {
    from { transform: translateY(0); }
    to { transform: translateY(-8px); }
  }

  @keyframes cue {
    0%, 100% { transform: scaleY(0.4); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 1; }
  }

  @media (max-width: 600px) {
    .hero { padding: 5rem 1.25rem 5.5rem; }
    .strip img { max-height: 56vh; }
    .hero-eyebrow { font-size: 0.66rem; letter-spacing: 0.1em; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-inner, .cue-line, .strip img { animation: none; }
  }
</style>

<script>
  import { ObservatorySky } from '../utils/observatory-sky.js';
  const canvas = document.querySelector<HTMLCanvasElement>('.hero .sky');
  if (canvas) new ObservatorySky(canvas);
</script>
