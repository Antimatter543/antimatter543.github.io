---
import { getEntry } from 'astro:content';

const nudge = await getEntry('projects', 'nudge');
const soulsync = await getEntry('projects', 'soulsync');

// Presentation copy lives here; links and images stay single-sourced from the
// projects collection so they never drift out of sync with the project pages.
const apps = [
  {
    entry: nudge,
    name: 'Nudge',
    tagline: 'Break the scroll, take back your time.',
    leadBadge: '500+ downloads',
    badges: ['Open source', 'Free forever', 'Zero internet permission'],
    why: `I built Nudge over a weekend out of two dislikes: paying for apps that should be free, and <em>letting trillion dollar companies have unfettered access to my increasingly-fragmented attention so that I may become a better consumer for their products.</em>`,
    blurb: `Instead of a hard lock it puts friction in the way: a breathing exercise or countdown before a blocked app opens. Long enough to break the autopilot loop and put intention back in front. It can also kill Reels, Shorts and the TikTok For You feed without blocking the whole app.`,
    ctaLabel: 'Get it on Google Play',
    accent: 'primary',
  },
  {
    entry: soulsync,
    name: 'SoulSync',
    tagline: 'A mood tracker that never phones home.',
    leadBadge: '100% on-device',
    badges: ['Open source', 'Free forever', '603 passing tests'],
    why: `Your emotional history is about the most private data you have, and every tracker I looked at wanted an account and a cloud to keep it in. So I wrote one where none of it ever leaves your phone.`,
    blurb: `Log mood, activities, notes and photos, and it surfaces honest patterns from your own history: real correlations with p-values and sample sizes, not vibes. Heart rate and HRV can go in the mix too. Everything lives in local SQLite, with JSON export if you ever want to walk away.`,
    ctaLabel: 'Get it on Google Play',
    accent: 'secondary',
  },
].filter((app) => app.entry);
---

<section id="apps" class="apps-section">
  <div class="container">
    <h2 class="section-title">Apps I've Shipped</h2>
    <div class="header-accent"></div>
    <p class="section-intro">
      Two Android apps, both free and both open source, built because I wanted them to exist and
      didn't want to pay a subscription for the privilege. No accounts, no ads, no telemetry.
    </p>

    <div class="apps-grid">
      {apps.map((app) => (
        <article class={`app-card accent-${app.accent}`}>
          <div class="app-glow"></div>

          <a
            href={app.entry!.data.liveUrl ?? app.entry!.data.externalUrl}
            class="app-banner"
            target="_blank"
            rel="noopener noreferrer"
            tabindex="-1"
            aria-hidden="true"
          >
            <img src={app.entry!.data.image} alt={app.entry!.data.imageAlt} loading="lazy" />
          </a>

          <div class="app-body">
            <div class="app-head">
              <h3 class="app-name">{app.name}</h3>
              <p class="app-tagline">{app.tagline}</p>
            </div>

            <div class="app-badges">
              <span class="badge badge-lead">{app.leadBadge}</span>
              {app.badges.map((badge) => (
                <span class="badge">{badge}</span>
              ))}
            </div>

            <blockquote class="app-why" set:html={app.why}></blockquote>

            <p class="app-blurb">{app.blurb}</p>

            <div class="app-actions">
              {(app.entry!.data.liveUrl ?? app.entry!.data.externalUrl) && (
                <a
                  href={app.entry!.data.liveUrl ?? app.entry!.data.externalUrl}
                  class="btn btn-solid"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M3.6 2.3a1 1 0 0 0-.5.9v17.6a1 1 0 0 0 .5.9l9.3-9.7-9.3-9.7Zm10.7 8.3 2.9-3L5.9 1.5a1 1 0 0 0-.4-.1l8.8 9.2Zm0 2.8L5.5 22.6a1 1 0 0 0 .4-.1l11.3-6.1-2.9-3Zm4.2-1.4 3-1.6c.8-.4.8-1.6 0-2l-3-1.6-3.3 3.3 3.3 3.3Z"/>
                  </svg>
                  {app.ctaLabel}
                </a>
              )}
              {app.entry!.data.githubUrl && (
                <a href={app.entry!.data.githubUrl} class="btn btn-ghost" target="_blank" rel="noopener noreferrer">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                    <path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1.1-.7.1-.7.1-.7 1.2.1 1.9 1.2 1.9 1.2 1.1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.8-1.6-2.7-.3-5.5-1.3-5.5-5.9 0-1.3.5-2.4 1.2-3.2-.1-.3-.5-1.5.1-3.2 0 0 1-.3 3.3 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.6 1.7.2 2.9.1 3.2.8.8 1.2 1.9 1.2 3.2 0 4.6-2.8 5.6-5.5 5.9.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6A12 12 0 0 0 12 .3Z"/>
                  </svg>
                  Source
                </a>
              )}
              {app.entry!.data.blogUrl && (
                <a href={app.entry!.data.blogUrl} class="btn btn-ghost">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/>
                    <path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/>
                  </svg>
                  Write-up
                </a>
              )}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .apps-section {
    padding: 6rem 0;
    background-color: var(--color-bg);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .section-title {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .header-accent {
    width: 60px;
    height: 3px;
    background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
    margin: 0 auto 1.75rem;
    border-radius: 2px;
  }

  .section-intro {
    max-width: 640px;
    margin: 0 auto 3rem;
    text-align: center;
    font-size: 1.05rem;
    line-height: 1.7;
    color: var(--color-text-alt);
  }

  /* ---- Grid ---- */
  .apps-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.75rem;
    align-items: stretch;
  }

  .app-card {
    position: relative;
    display: flex;
    flex-direction: column;
    background: var(--glass-bg);
    border: 1px solid var(--glass-border);
    border-radius: var(--radius-xl);
    overflow: hidden;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: var(--glass-shadow);
    transition: transform 0.4s cubic-bezier(0.19, 1, 0.22, 1), box-shadow 0.4s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .app-card:hover {
    transform: translateY(-4px);
    box-shadow: var(--card-hover-shadow);
  }

  .app-glow {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--primary-color), var(--secondary-color), transparent);
    opacity: 0;
    transition: opacity 0.4s ease;
    z-index: 2;
  }

  .accent-secondary .app-glow {
    background: linear-gradient(90deg, transparent, var(--secondary-color), var(--primary-color), transparent);
  }

  .app-card:hover .app-glow {
    opacity: 1;
  }

  /* ---- Banner ---- */
  .app-banner {
    display: block;
    overflow: hidden;
    background: rgba(0, 0, 0, 0.12);
    line-height: 0;
  }

  [data-theme="light"] .app-banner {
    background: rgba(0, 0, 0, 0.04);
  }

  .app-banner img {
    width: 100%;
    aspect-ratio: 1024 / 500;
    object-fit: cover;
    transition: transform 0.6s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .app-card:hover .app-banner img {
    transform: scale(1.03);
  }

  /* ---- Body ---- */
  .app-body {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    flex: 1;
  }

  .app-name {
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-heading);
    margin: 0 0 0.3rem;
  }

  .app-tagline {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--primary-color);
  }

  .accent-secondary .app-tagline {
    color: var(--secondary-color);
  }

  /* ---- Badges ---- */
  .app-badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .badge {
    display: inline-block;
    padding: 0.25rem 0.7rem;
    border-radius: 100px;
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--color-text-alt);
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--color-border);
  }

  [data-theme="light"] .badge {
    background: rgba(0, 0, 0, 0.03);
  }

  .badge-lead {
    color: var(--accent-color);
    background: rgba(245, 158, 11, 0.1);
    border-color: rgba(245, 158, 11, 0.25);
    font-weight: 600;
  }

  [data-theme="light"] .badge-lead {
    background: rgba(234, 88, 12, 0.08);
    border-color: rgba(234, 88, 12, 0.25);
  }

  /* ---- Why quote ---- */
  .app-why {
    margin: 0;
    padding: 0.1rem 0 0.1rem 1rem;
    border-left: 2px solid var(--primary-color);
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  .accent-secondary .app-why {
    border-left-color: var(--secondary-color);
  }

  .app-why {
    font-style: italic;
  }

  .app-why :global(em) {
    font-style: normal;
    font-weight: 600;
    color: var(--color-heading);
    background: linear-gradient(transparent 65%, rgba(245, 158, 11, 0.18) 65%);
  }

  .app-blurb {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--color-text-alt);
  }

  /* ---- Actions ---- */
  .app-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }

  .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.6rem 1.1rem;
    border-radius: var(--radius-md);
    font-size: 0.88rem;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.19, 1, 0.22, 1);
  }

  .btn-solid {
    background: var(--primary-color);
    color: var(--color-bg);
    border: 1px solid var(--primary-color);
  }

  .accent-secondary .btn-solid {
    background: var(--secondary-color);
    border-color: var(--secondary-color);
    color: #fff;
  }

  .btn-solid:hover {
    transform: translateY(-2px);
    box-shadow: var(--glow-primary);
  }

  .accent-secondary .btn-solid:hover {
    box-shadow: var(--glow-secondary);
  }

  .btn-ghost {
    background: rgba(100, 255, 218, 0.06);
    color: var(--primary-color);
    border: 1px solid rgba(100, 255, 218, 0.2);
  }

  [data-theme="light"] .btn-ghost {
    background: rgba(8, 145, 178, 0.06);
    border-color: rgba(8, 145, 178, 0.2);
  }

  .btn-ghost:hover {
    background: var(--primary-color);
    color: var(--color-bg);
    border-color: var(--primary-color);
    transform: translateY(-2px);
  }

  /* ---- Responsive ---- */
  @media (max-width: 900px) {
    .apps-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }
  }

  @media (max-width: 768px) {
    .apps-section {
      padding: 4rem 0;
    }

    .container {
      padding: 0 1rem;
    }

    .section-title {
      font-size: 2rem;
    }

    .app-body {
      padding: 1.35rem;
    }

    .app-name {
      font-size: 1.4rem;
    }

    .btn {
      flex: 1 1 auto;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .app-card,
    .app-banner img,
    .btn {
      transition: none;
    }

    .app-card:hover {
      transform: none;
    }

    .app-card:hover .app-banner img {
      transform: none;
    }
  }
</style>
